@page "/chart-test"
@using GexVisor.Core
@using GexVisor.UI.Components.Charts
@using GexVisor.UI.Services
@using Microsoft.AspNetCore.Components
@inject IPriceDataService PriceService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Chart Test - GexVisor</PageTitle>

<div class="chart-test-page">
    <header class="page-header">
        <h1>Chart Library Test</h1>
        <p class="subtitle">ApexCharts Blazor Integration</p>
    </header>

    <section class="controls-section">
        <div class="control-group">
            <label>Symbol</label>
            <input type="text" @bind="symbol" @bind:event="oninput" placeholder="SPY" />
        </div>
        <div class="control-group">
            <label>Timeframe</label>
            <select @bind="timeframe">
                <option value="1d">Daily</option>
                <option value="1h">Hourly</option>
                <option value="15m">15 Min</option>
                <option value="5m">5 Min</option>
            </select>
        </div>
        <div class="control-group">
            <label>Bars</label>
            <select @bind="limit">
                <option value="30">30</option>
                <option value="60">60</option>
                <option value="100">100</option>
                <option value="200">200</option>
            </select>
        </div>
        <div class="control-group">
            <label>Data Source</label>
            <select @bind="dataSource">
                <option value="live">Live API</option>
                <option value="sample">Sample Data</option>
            </select>
        </div>
        <button class="btn-primary" @onclick="LoadData" disabled="@isLoading">
            @if (isLoading)
            {
                <i class="fas fa-spinner fa-spin"></i>
                <span>Loading...</span>
            }
            else
            {
                <i class="fas fa-sync-alt"></i>
                <span>Load Data</span>
            }
        </button>
        <button class="btn-secondary" @onclick="ExportCsv" disabled="@(bars.Count == 0)" title="Export to CSV">
            <i class="fas fa-download"></i>
        </button>
        <button class="btn-secondary" @onclick="CopyShareUrl" title="Copy share URL">
            <i class="fas fa-share-alt"></i>
        </button>
    </section>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-banner">
            <i class="fas fa-exclamation-triangle"></i>
            <span>@errorMessage</span>
            <button @onclick="() => errorMessage = null">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }

    <section class="chart-section">
        <CandlestickChart Title="@ChartTitle"
                          Symbol="@symbol"
                          Bars="bars"
                          Height="400" />
    </section>

    <section class="info-section">
        <div class="info-card">
            <h3>Status</h3>
            <dl>
                <dt>Library</dt>
                <dd>Blazor-ApexCharts 6.1.0</dd>
                <dt>Data Source</dt>
                <dd class="@(dataSource == "live" ? "live-source" : "")">
                    @(dataSource == "live" ? "Live API" : "Sample Data")
                </dd>
                <dt>Data Points</dt>
                <dd>@bars.Count</dd>
                <dt>Date Range</dt>
                <dd>@DateRange</dd>
            </dl>
        </div>
        <div class="info-card">
            <h3>Chart Viewer Epic (#111)</h3>
            <ul>
                <li class="completed"><strong>#129</strong> - Library Selection</li>
                <li class="completed"><strong>#130</strong> - Price Data Service</li>
                <li class="completed"><strong>#131</strong> - Trade Chart Component</li>
                <li class="completed"><strong>#132</strong> - Trade Journal Integration</li>
                <li class="completed"><strong>#133</strong> - Export and Sharing</li>
            </ul>
        </div>
    </section>

    @if (showCopiedToast)
    {
        <div class="toast">URL copied to clipboard!</div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "symbol")]
    public string? QuerySymbol { get; set; }

    [SupplyParameterFromQuery(Name = "tf")]
    public string? QueryTimeframe { get; set; }

    private string symbol = "SPY";
    private string timeframe = "1d";
    private int limit = 100;
    private string dataSource = "live";
    private List<OhlcvBar> bars = new();
    private bool isLoading = false;
    private string? errorMessage = null;
    private bool showCopiedToast = false;
    private Random random = new();

    private string ChartTitle => $"{symbol.ToUpper()} - {(dataSource == "live" ? "Live" : "Sample")} ({timeframe})";

    private string DateRange => bars.Count > 0
        ? $"{bars.First().Timestamp:MMM d} - {bars.Last().Timestamp:MMM d, yyyy}"
        : "N/A";

    protected override async Task OnInitializedAsync()
    {
        // Apply URL parameters if present
        if (!string.IsNullOrWhiteSpace(QuerySymbol))
            symbol = QuerySymbol.ToUpperInvariant();
        if (!string.IsNullOrWhiteSpace(QueryTimeframe))
            timeframe = QueryTimeframe;

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            if (dataSource == "live")
            {
                await LoadLiveData();
            }
            else
            {
                GenerateSampleData();
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadLiveData()
    {
        var result = await PriceService.GetCandlesAsync(symbol, timeframe, limit);

        if (result.Success)
        {
            bars = result.Bars;
        }
        else
        {
            errorMessage = result.Error ?? "Failed to load data";
            // Fall back to sample data
            GenerateSampleData();
            errorMessage += " (showing sample data)";
        }
    }

    private async Task ExportCsv()
    {
        if (bars.Count == 0) return;

        var csv = ChartExport.ToCsv(bars, symbol);
        var filename = ChartExport.GenerateCsvFilename(symbol, timeframe);

        // Use JS interop to trigger download
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $@"
            const link = document.createElement('a');
            link.href = 'data:text/csv;base64,{base64}';
            link.download = '{filename}';
            link.click();
        ");
    }

    private async Task CopyShareUrl()
    {
        var baseUrl = Navigation.ToAbsoluteUri("/chart-test").ToString().Split('?')[0];
        var shareUrl = ChartExport.BuildShareUrl(baseUrl, symbol, timeframe);

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", shareUrl);

        showCopiedToast = true;
        StateHasChanged();

        // Hide toast after 2 seconds
        await Task.Delay(2000);
        showCopiedToast = false;
        StateHasChanged();
    }

    private void GenerateSampleData()
    {
        bars.Clear();

        var basePrice = symbol.ToUpper() switch
        {
            "SPY" => 475m,
            "QQQ" => 400m,
            "IWM" => 200m,
            "AAPL" => 180m,
            "MSFT" => 380m,
            "NVDA" => 500m,
            _ => 100m
        };

        var endDate = DateTime.Now.Date;
        var days = timeframe switch
        {
            "1d" => limit,
            "1h" => limit / 6,
            "15m" => limit / 26,
            "5m" => limit / 78,
            _ => limit
        };
        var startDate = endDate.AddDays(-Math.Max(days, 7));

        var currentPrice = basePrice;
        var currentDate = startDate;

        while (currentDate <= endDate && bars.Count < limit)
        {
            if (currentDate.DayOfWeek != DayOfWeek.Saturday && currentDate.DayOfWeek != DayOfWeek.Sunday)
            {
                var dailyVolatility = 0.02m;
                var trend = (decimal)(random.NextDouble() - 0.48) * dailyVolatility * currentPrice;

                var open = currentPrice;
                var close = currentPrice + trend + (decimal)(random.NextDouble() - 0.5) * dailyVolatility * currentPrice;
                close = Math.Max(close, basePrice * 0.5m);

                var range = Math.Abs(close - open) + (decimal)random.NextDouble() * dailyVolatility * currentPrice;
                var high = Math.Max(open, close) + (decimal)random.NextDouble() * range * 0.5m;
                var low = Math.Min(open, close) - (decimal)random.NextDouble() * range * 0.5m;
                low = Math.Max(low, basePrice * 0.4m);

                var volume = (long)(random.NextDouble() * 50_000_000 + 10_000_000);

                bars.Add(new OhlcvBar
                {
                    Symbol = symbol.ToUpper(),
                    Timestamp = currentDate.AddHours(9).AddMinutes(30),
                    Open = Math.Round(open, 2),
                    High = Math.Round(high, 2),
                    Low = Math.Round(low, 2),
                    Close = Math.Round(close, 2),
                    Volume = volume
                });

                currentPrice = close;
            }

            currentDate = currentDate.AddDays(1);
        }
    }
}
