@page "/chart-test"
@using GexVisor.Core
@using GexVisor.UI.Components.Charts

<PageTitle>Chart Test - GexVisor</PageTitle>

<div class="chart-test-page">
    <header class="page-header">
        <h1>Chart Library Test</h1>
        <p class="subtitle">ApexCharts Blazor Integration (Issue #129)</p>
    </header>

    <section class="controls-section">
        <div class="control-group">
            <label>Symbol</label>
            <input type="text" @bind="symbol" @bind:event="oninput" placeholder="SPY" />
        </div>
        <div class="control-group">
            <label>Days</label>
            <select @bind="days">
                <option value="7">7 Days</option>
                <option value="30">30 Days</option>
                <option value="90">90 Days</option>
                <option value="180">180 Days</option>
                <option value="365">1 Year</option>
            </select>
        </div>
        <button class="btn-primary" @onclick="GenerateSampleData">
            <i class="fas fa-sync-alt"></i> Generate Sample Data
        </button>
    </section>

    <section class="chart-section">
        <CandlestickChart Title="@($"{symbol.ToUpper()} - Sample Data")"
                          Symbol="@symbol"
                          Bars="sampleBars"
                          Height="400" />
    </section>

    <section class="info-section">
        <div class="info-card">
            <h3>Status</h3>
            <dl>
                <dt>Library</dt>
                <dd>Blazor-ApexCharts 6.1.0</dd>
                <dt>Data Points</dt>
                <dd>@sampleBars.Count</dd>
                <dt>Date Range</dt>
                <dd>@(sampleBars.Count > 0 ? $"{sampleBars.First().Timestamp:MMM d} - {sampleBars.Last().Timestamp:MMM d, yyyy}" : "N/A")</dd>
            </dl>
        </div>
        <div class="info-card">
            <h3>Next Steps</h3>
            <ul>
                <li><strong>#130</strong> - Connect to PriceDataService</li>
                <li><strong>#131</strong> - Add trade markers</li>
                <li><strong>#132</strong> - Integrate with Trade Journal</li>
            </ul>
        </div>
    </section>
</div>

@code {
    private string symbol = "SPY";
    private int days = 30;
    private List<OhlcvBar> sampleBars = new();
    private Random random = new();

    protected override void OnInitialized()
    {
        GenerateSampleData();
    }

    private void GenerateSampleData()
    {
        sampleBars.Clear();

        var basePrice = symbol.ToUpper() switch
        {
            "SPY" => 475m,
            "QQQ" => 400m,
            "IWM" => 200m,
            "AAPL" => 180m,
            "MSFT" => 380m,
            "NVDA" => 500m,
            _ => 100m
        };

        var endDate = DateTime.Now.Date;
        var startDate = endDate.AddDays(-days);

        var currentPrice = basePrice;
        var currentDate = startDate;

        while (currentDate <= endDate)
        {
            // Skip weekends
            if (currentDate.DayOfWeek != DayOfWeek.Saturday && currentDate.DayOfWeek != DayOfWeek.Sunday)
            {
                // Generate realistic OHLCV data
                var dailyVolatility = 0.02m; // 2% daily volatility
                var trend = (decimal)(random.NextDouble() - 0.48) * dailyVolatility * currentPrice;

                var open = currentPrice;
                var close = currentPrice + trend + (decimal)(random.NextDouble() - 0.5) * dailyVolatility * currentPrice;
                close = Math.Max(close, basePrice * 0.5m);

                var range = Math.Abs(close - open) + (decimal)random.NextDouble() * dailyVolatility * currentPrice;
                var high = Math.Max(open, close) + (decimal)random.NextDouble() * range * 0.5m;
                var low = Math.Min(open, close) - (decimal)random.NextDouble() * range * 0.5m;
                low = Math.Max(low, basePrice * 0.4m);

                var volume = (long)(random.NextDouble() * 50_000_000 + 10_000_000);

                sampleBars.Add(new OhlcvBar
                {
                    Symbol = symbol.ToUpper(),
                    Timestamp = currentDate.AddHours(9).AddMinutes(30),
                    Open = Math.Round(open, 2),
                    High = Math.Round(high, 2),
                    Low = Math.Round(low, 2),
                    Close = Math.Round(close, 2),
                    Volume = volume
                });

                currentPrice = close;
            }

            currentDate = currentDate.AddDays(1);
        }
    }
}
