@page "/research/pipeline"
@using GexVisor.UI.Components.Research

<PageTitle>Data Pipeline State Diagram - GexVisor</PageTitle>

<div class="pipeline-page">
    <header class="pipeline-header">
        <div class="header-left">
            <a href="/arcade" class="back-link">
                <i class="fas fa-arrow-left"></i> Research Arcade
            </a>
            <h1>Multi-Tier Data Pipeline</h1>
            <span class="subtitle">State Diagram View | Big Data Engineering</span>
        </div>
    </header>

    <div class="legend">
        <div class="legend-item">
            <div class="legend-color source"></div>
            <span>Data Source</span>
        </div>
        <div class="legend-item">
            <div class="legend-color process"></div>
            <span>Processing</span>
        </div>
        <div class="legend-item">
            <div class="legend-color storage"></div>
            <span>Storage</span>
        </div>
        <div class="legend-item">
            <div class="legend-color output"></div>
            <span>Output</span>
        </div>
    </div>

    <p class="hint">Click any state to see implementation details</p>

    <div class="state-diagram">
        <!-- Data Sources Row -->
        <div class="state-row">
            <div class="parallel-states">
                <div class="state source @(_activeState == "sources" ? "active" : "")" @onclick='() => ShowDetail("sources")'>
                    <div class="state-name">API Source A</div>
                    <div class="state-type">External</div>
                </div>
                <div class="state source @(_activeState == "sources" ? "active" : "")" @onclick='() => ShowDetail("sources")'>
                    <div class="state-name">API Source B</div>
                    <div class="state-type">External</div>
                </div>
                <div class="state source @(_activeState == "sources" ? "active" : "")" @onclick='() => ShowDetail("sources")'>
                    <div class="state-name">File Source</div>
                    <div class="state-type">Batch</div>
                </div>
            </div>
        </div>

        <div class="arrow">
            <div class="arrow-line"></div>
            <div class="arrow-head"></div>
            <div class="arrow-label">rate limited</div>
        </div>

        <!-- Ingestion Layer -->
        <div class="state-row">
            <div class="state process @(_activeState == "ingestion" ? "active" : "")" @onclick='() => ShowDetail("ingestion")'>
                <div class="state-name">Ingestion Layer</div>
                <div class="state-type">Normalize + Validate</div>
            </div>
        </div>

        <div class="arrow">
            <div class="arrow-line"></div>
            <div class="arrow-head"></div>
            <div class="arrow-label">validated records</div>
        </div>

        <!-- Primary Database -->
        <div class="state-row">
            <div class="state storage @(_activeState == "primary-db" ? "active" : "")" @onclick='() => ShowDetail("primary-db")'>
                <div class="state-name">Primary Database</div>
                <div class="state-type">Partitioned Storage</div>
            </div>
        </div>

        <div class="arrow">
            <div class="arrow-line"></div>
            <div class="arrow-head"></div>
            <div class="arrow-label">query</div>
        </div>

        <!-- Cache Layer -->
        <div class="state-row">
            <div class="parallel-states">
                <div class="state storage @(_activeState == "cache" ? "active" : "")" @onclick='() => ShowDetail("cache")'>
                    <div class="state-name">Metadata Cache</div>
                    <div class="state-type">SQLite</div>
                </div>
                <div class="state storage @(_activeState == "cache" ? "active" : "")" @onclick='() => ShowDetail("cache")'>
                    <div class="state-name">File Cache</div>
                    <div class="state-type">Pickle/Parquet</div>
                </div>
            </div>
        </div>

        <div class="arrow">
            <div class="arrow-line"></div>
            <div class="arrow-head"></div>
            <div class="arrow-label">cache hit/miss</div>
        </div>

        <!-- Parallel Processor -->
        <div class="state-row">
            <div class="state process @(_activeState == "processing" ? "active" : "")" @onclick='() => ShowDetail("processing")'>
                <div class="state-name">Parallel Processor</div>
                <div class="state-type">ThreadPool Workers</div>
            </div>
        </div>

        <div class="arrow">
            <div class="arrow-line"></div>
            <div class="arrow-head"></div>
            <div class="arrow-label">results</div>
        </div>

        <!-- Output -->
        <div class="state-row">
            <div class="state output @(_activeState == "output" ? "active" : "")" @onclick='() => ShowDetail("output")'>
                <div class="state-name">Output / Analysis</div>
                <div class="state-type">Final State</div>
            </div>
        </div>
    </div>

    <!-- Detail Panels -->
    @if (_activeState == "sources")
    {
        <DetailPanel Title="Data Sources (Heterogeneous Ingestion)" OnClose="CloseDetail">
            <div class="detail-card">
                <h4>Challenge</h4>
                <ul>
                    <li>Different schemas per source <span class="concept-tag">Integration</span></li>
                    <li>Varying rate limits <span class="concept-tag">Throttling</span></li>
                    <li>Multiple formats (JSON, CSV) <span class="concept-tag">Parsing</span></li>
                    <li>Availability differences <span class="concept-tag">Reliability</span></li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Design Pattern</h4>
                <ul>
                    <li>Adapter per source type</li>
                    <li>Common interface contract</li>
                    <li>Fallback chain on failure</li>
                    <li>Exponential backoff retry</li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Discussion</h4>
                <ul>
                    <li>When add another source?</li>
                    <li>How handle schema changes?</li>
                    <li>Cost of redundancy?</li>
                    <li>Testing strategy?</li>
                </ul>
            </div>
        </DetailPanel>
    }

    @if (_activeState == "ingestion")
    {
        <DetailPanel Title="Ingestion Layer (Normalize + Validate)" OnClose="CloseDetail">
            <div class="detail-card">
                <h4>Responsibilities</h4>
                <ul>
                    <li>Schema normalization <span class="concept-tag">ETL</span></li>
                    <li>Data type coercion <span class="concept-tag">Transform</span></li>
                    <li>Quality validation <span class="concept-tag">Quality</span></li>
                    <li>Deduplication <span class="concept-tag">Cleaning</span></li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Validation Rules</h4>
                <ul>
                    <li>Required fields present</li>
                    <li>Value range checks</li>
                    <li>Cross-field consistency</li>
                    <li>Format validation</li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Discussion</h4>
                <ul>
                    <li>Fail fast vs collect errors?</li>
                    <li>Quarantine bad records?</li>
                    <li>Schema evolution handling?</li>
                    <li>Idempotency guarantees?</li>
                </ul>
            </div>
        </DetailPanel>
    }

    @if (_activeState == "primary-db")
    {
        <DetailPanel Title="Primary Database (Partitioned Storage)" OnClose="CloseDetail">
            <div class="detail-card">
                <h4>Partitioning Strategy</h4>
                <ul>
                    <li>Range (by date) <span class="concept-tag">Time-series</span></li>
                    <li>Hash (by key) <span class="concept-tag">Distribution</span></li>
                    <li>List (by category) <span class="concept-tag">Grouping</span></li>
                    <li>Composite strategies</li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Benefits</h4>
                <ul>
                    <li>Partition pruning in queries</li>
                    <li>Parallel reads possible</li>
                    <li>Independent maintenance</li>
                    <li>Easier data lifecycle</li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Discussion</h4>
                <ul>
                    <li>When NOT to partition?</li>
                    <li>Choosing partition key?</li>
                    <li>Cross-partition queries?</li>
                    <li>Rebalancing partitions?</li>
                </ul>
            </div>
        </DetailPanel>
    }

    @if (_activeState == "cache")
    {
        <DetailPanel Title="Cache Layer (Multi-Format)" OnClose="CloseDetail">
            <div class="detail-card">
                <h4>Cache Tiers</h4>
                <ul>
                    <li>In-memory (hot) <span class="concept-tag">Fast</span></li>
                    <li>File-based (warm) <span class="concept-tag">Persistent</span></li>
                    <li>Database (warm) <span class="concept-tag">Queryable</span></li>
                    <li>Origin (cold) <span class="concept-tag">Source</span></li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Format Trade-offs</h4>
                <ul>
                    <li>Pickle: Fast, Python-only</li>
                    <li>Parquet: Columnar, portable</li>
                    <li>JSON: Readable, verbose</li>
                    <li>CSV: Universal, inefficient</li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Discussion</h4>
                <ul>
                    <li>Cache invalidation strategy?</li>
                    <li>TTL vs event-based expiry?</li>
                    <li>Cache warming approaches?</li>
                    <li>Measuring hit rate?</li>
                </ul>
            </div>
        </DetailPanel>
    }

    @if (_activeState == "processing")
    {
        <DetailPanel Title="Parallel Processor (ThreadPool Workers)" OnClose="CloseDetail">
            <div class="detail-card">
                <h4>Parallelism Types</h4>
                <ul>
                    <li>Task parallel <span class="concept-tag">Different ops</span></li>
                    <li>Data parallel <span class="concept-tag">Same op</span></li>
                    <li>Pipeline parallel <span class="concept-tag">Stages</span></li>
                    <li>Hybrid approaches</li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Worker Allocation</h4>
                <ul>
                    <li>Adaptive to CPU count</li>
                    <li>Leave headroom for OS</li>
                    <li>Memory-bounded limits</li>
                    <li>I/O vs CPU bound tuning</li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Discussion</h4>
                <ul>
                    <li>Threads vs Processes?</li>
                    <li>When use Spark instead?</li>
                    <li>Handling partial failures?</li>
                    <li>Progress monitoring?</li>
                </ul>
            </div>
        </DetailPanel>
    }

    @if (_activeState == "output")
    {
        <DetailPanel Title="Output / Analysis (Final State)" OnClose="CloseDetail">
            <div class="detail-card">
                <h4>Output Formats</h4>
                <ul>
                    <li>Structured reports <span class="concept-tag">Analytics</span></li>
                    <li>API responses <span class="concept-tag">Service</span></li>
                    <li>File exports <span class="concept-tag">Batch</span></li>
                    <li>Database writes <span class="concept-tag">Persist</span></li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Quality Assurance</h4>
                <ul>
                    <li>Output validation</li>
                    <li>Completeness checks</li>
                    <li>Audit logging</li>
                    <li>Rollback capability</li>
                </ul>
            </div>
            <div class="detail-card">
                <h4>Discussion</h4>
                <ul>
                    <li>Downstream consumers?</li>
                    <li>SLA requirements?</li>
                    <li>Error notification?</li>
                    <li>Reprocessing strategy?</li>
                </ul>
            </div>
        </DetailPanel>
    }

    <!-- Key Concepts Section -->
    <h2 class="section-title">Key Concepts in This Pipeline</h2>

    <div class="concepts-grid">
        <div class="concept-card">
            <h3>1. Heterogeneous Data Integration</h3>
            <p>Combining data from multiple sources with different schemas, formats, and access patterns into a unified pipeline.</p>
            <pre class="code-example">class SourceAdapter(ABC):
    @@abstractmethod
    def fetch(self, params) -> DataFrame:
        pass

    @@abstractmethod
    def normalize(self, raw) -> DataFrame:
        pass</pre>
        </div>

        <div class="concept-card">
            <h3>2. Multi-Tier Storage</h3>
            <p>Hot/warm/cold data tiers optimize for different access patterns - frequently used data stays fast, historical data moves to cheaper storage.</p>
            <pre class="code-example">def get_data(key):
    if key in memory_cache:      # Hot
        return memory_cache[key]
    if key in file_cache:        # Warm
        return file_cache[key]
    return fetch_from_api(key)   # Cold</pre>
        </div>

        <div class="concept-card">
            <h3>3. Rate Limiting</h3>
            <p>External APIs have request limits. Efficient rate limiting prevents wasted requests and handles backpressure gracefully.</p>
            <pre class="code-example">from collections import deque

class RateLimiter:
    def __init__(self, max_req, window_sec):
        self.window = deque(maxlen=max_req)
        self.window_sec = window_sec</pre>
        </div>

        <div class="concept-card">
            <h3>4. Horizontal Partitioning</h3>
            <p>Splitting large tables by a key (often date) enables parallel processing and efficient queries via partition pruning.</p>
            <pre class="code-example">CREATE TABLE events (
    id SERIAL,
    event_date DATE,
    data JSONB
) PARTITION BY RANGE (event_date);

CREATE TABLE events_2024
PARTITION OF events
FOR VALUES FROM ('2024-01-01')
TO ('2025-01-01');</pre>
        </div>

        <div class="concept-card">
            <h3>5. Data Quality Scoring</h3>
            <p>Quantifiable quality metrics enable automated decisions about data fitness for downstream use.</p>
            <pre class="code-example">def quality_score(record):
    checks = {
        'complete': all_fields_present(record),
        'valid': values_in_range(record),
        'consistent': cross_field_ok(record)
    }
    weights = [0.4, 0.35, 0.25]
    return sum(c*w for c,w in zip(checks.values(), weights))</pre>
        </div>

        <div class="concept-card">
            <h3>6. Parallel Processing</h3>
            <p>For I/O-bound work that fits on one machine, thread pools provide simple parallelism without distributed system complexity.</p>
            <pre class="code-example">from concurrent.futures import ThreadPoolExecutor

workers = max(2, min(8, cpu_count() - 1))

with ThreadPoolExecutor(workers) as pool:
    results = list(pool.map(process, items))</pre>
        </div>
    </div>

    <!-- Discussion Sections -->
    <div class="discussion-box">
        <h3>Discussion: When to Scale Out?</h3>
        <ul>
            <li><strong>Single-machine parallelism</strong> works when data fits in memory and processing is I/O-bound. When would you switch to Spark or similar?</li>
            <li><strong>Relational databases</strong> scale vertically well. At what point do you need horizontal scaling (sharding)?</li>
            <li><strong>File caching</strong> works great for single nodes. What would you use for a distributed deployment?</li>
            <li><strong>Rate limiting in-process</strong> is simple. How would you coordinate limits across multiple workers?</li>
        </ul>
    </div>

    <div class="discussion-box">
        <h3>For Your Project</h3>
        <ul>
            <li>What are your data sources? How do their schemas differ?</li>
            <li>Where does validation happen in your pipeline?</li>
            <li>What storage tier(s) make sense for your data volume?</li>
            <li>Do you need parallelism? What type?</li>
        </ul>
    </div>

    <footer class="pipeline-footer">
        Big Data Engineering | Pipeline Architecture
    </footer>
</div>

@code {
    private string? _activeState;

    private void ShowDetail(string state)
    {
        _activeState = state;
    }

    private void CloseDetail()
    {
        _activeState = null;
    }
}
