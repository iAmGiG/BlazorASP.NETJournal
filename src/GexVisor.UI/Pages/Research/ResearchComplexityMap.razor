@page "/research/complexity"
@using GexVisor.UI.Models
@using GexVisor.UI.Components.Research
@using Microsoft.AspNetCore.Components

<PageTitle>Research Complexity Map - GexVisor</PageTitle>

<div class="complexity-page">
    <header class="complexity-header">
        <div class="header-left">
            <a href="/arcade" class="back-link">
                <i class="fas fa-arrow-left"></i> Research Arcade
            </a>
            <div class="title-group">
                <h1>Research Complexity Map</h1>
                <span class="subtitle">Mapping Abandoned &amp; Deferred Research by Barrier Type</span>
            </div>
        </div>
        <div class="header-right">
            <div class="view-toggle">
                <button class="view-btn @(_viewMode == ViewMode.Cards ? "active" : "")"
                        @onclick="@(() => _viewMode = ViewMode.Cards)"
                        title="Card View">
                    <i class="fas fa-th-large"></i> Cards
                </button>
                <button class="view-btn @(_viewMode == ViewMode.Radar ? "active" : "")"
                        @onclick="@(() => _viewMode = ViewMode.Radar)"
                        title="Radar View">
                    <i class="fas fa-bullseye"></i> Radar
                </button>
            </div>
        </div>
    </header>

    <!-- Foundation Stats -->
    <div class="foundation-banner">
        <div class="foundation-stat">
            <div class="foundation-value">@RadarConstants.FoundationStats.DetectionRate</div>
            <div class="foundation-label">Detection Rate</div>
        </div>
        <div class="foundation-stat">
            <div class="foundation-value">@RadarConstants.FoundationStats.Accuracy</div>
            <div class="foundation-label">Accuracy</div>
        </div>
        <div class="foundation-stat">
            <div class="foundation-value">@RadarConstants.FoundationStats.TradingDays</div>
            <div class="foundation-label">Trading Days</div>
        </div>
        <div class="foundation-stat">
            <div class="foundation-value">@ResearchPathData.Paths.Length</div>
            <div class="foundation-label">Research Paths</div>
        </div>
    </div>

    <div class="main-container">
        <!-- Filters -->
        <aside class="filters-panel">
            <div class="filter-section">
                <div class="filter-title">Barrier Type</div>
                <div class="filter-group">
                    <button class="filter-btn @(_barrierFilter == null ? "active" : "")" @onclick="@(() => SetBarrierFilter(null))">
                        All
                    </button>
                    @foreach (var q in ResearchPathData.Quadrants.Where(x => x.Key != ResearchQuadrant.None))
                    {
                        var count = GetFilteredPaths().Count(p => p.BarrierQuadrant == q.Key || (q.Key == ResearchQuadrant.Scope && p.Quadrant == ResearchQuadrant.Scope));
                        <button class="filter-btn @(_barrierFilter == q.Key ? "active" : "")"
                                style="--filter-color: @q.Value.Color"
                                @onclick="@(() => SetBarrierFilter(q.Key))">
                            @q.Value.Label.ToLowerInvariant().Replace("_", " ") <span class="count">@count</span>
                        </button>
                    }
                </div>
            </div>

            <div class="filter-section">
                <div class="filter-title">Status</div>
                <div class="filter-group status-group">
                    @foreach (var status in ResearchPathData.StatusColors)
                    {
                        var count = GetFilteredPaths().Count(p => p.Status == status.Key);
                        <button class="filter-btn @(_statusFilter == status.Key ? "active" : "")"
                                style="--filter-color: @status.Value"
                                @onclick="@(() => ToggleStatusFilter(status.Key))">
                            <span class="status-dot" style="background: @status.Value"></span>
                            @FormatEnumName(status.Key) <span class="count">@count</span>
                        </button>
                    }
                </div>
            </div>

            <div class="filter-section">
                <div class="filter-title">Complexity</div>
                <div class="filter-group">
                    @for (int i = 0; i <= 5; i++)
                    {
                        var ring = i;
                        var count = GetFilteredPaths().Count(p => p.Ring == ring);
                        <button class="filter-btn ring-btn @(_ringFilter == ring ? "active" : "")"
                                @onclick="@(() => ToggleRingFilter(ring))">
                            Ring @ring <span class="count">@count</span>
                        </button>
                    }
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="content-area">
            @if (_viewMode == ViewMode.Cards)
            {
                <!-- Ring Legend -->
                <div class="ring-legend">
                    @for (int i = 0; i <= 5; i++)
                    {
                        <div class="ring-item">
                            <span class="ring-num">@i</span>
                            <span class="ring-name">@ResearchPathData.RingNames[i]</span>
                        </div>
                    }
                </div>

                <!-- Path Cards Grid -->
                <div class="paths-grid">
                    @foreach (var path in GetFilteredPaths().OrderBy(p => p.Ring).ThenBy(p => p.Title))
                    {
                        var statusColor = ResearchPathData.StatusColors.GetValueOrDefault(path.Status, "#888");
                        var taxonomyColor = ResearchPathData.TaxonomyColors.GetValueOrDefault(path.Taxonomy, ("#888", "#fff"));
                        var quadrantInfo = ResearchPathData.Quadrants.GetValueOrDefault(path.Quadrant, ("Unknown", "#888"));

                        <div class="path-card @(_selectedPath?.Id == path.Id ? "selected" : "")"
                             style="--status-color: @statusColor"
                             @onclick="@(() => SelectPath(path))">
                            <div class="card-header">
                                <div class="card-ring">Ring @path.Ring</div>
                                <div class="card-taxonomy" style="background: @taxonomyColor.Item1; color: @taxonomyColor.Item2">
                                    @FormatEnumName(path.Taxonomy).ToUpperInvariant()
                                </div>
                            </div>
                            <div class="card-title">@path.Title</div>
                            <div class="card-labels">
                                <span class="label-short">@path.Label</span>
                                @if (!string.IsNullOrEmpty(path.LabelLong))
                                {
                                    <span class="label-long">@path.LabelLong</span>
                                }
                            </div>
                            <div class="card-meta">
                                <span class="status-badge" style="background: @statusColor">@FormatEnumName(path.Status)</span>
                                <span class="quadrant-badge" style="color: @quadrantInfo.Item2">@quadrantInfo.Item1</span>
                            </div>
                            @if (!string.IsNullOrEmpty(path.Paper) && path.Paper != "N/A")
                            {
                                <div class="card-paper">@path.Paper</div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Radar View - using InteractiveRadar component -->
                <div class="radar-container">
                    <InteractiveRadar
                        Size="650"
                        SelectedPathId="@_selectedPath?.Id"
                        FilteredPaths="@GetFilteredPaths().ToList()"
                        OnNodeClick="@SelectPath"
                        OnNodeHover="@HandleNodeHover" />
                </div>
            }
        </div>

        <!-- Detail Panel -->
        <aside class="details-panel">
            @if (_selectedPath != null)
            {
                var statusColor = ResearchPathData.StatusColors.GetValueOrDefault(_selectedPath.Status, "#888");
                var taxonomyColor = ResearchPathData.TaxonomyColors.GetValueOrDefault(_selectedPath.Taxonomy, ("#888", "#fff"));
                var quadrantInfo = ResearchPathData.Quadrants.GetValueOrDefault(_selectedPath.Quadrant, ("Unknown", "#888"));

                <div class="detail-header">
                    <div class="detail-title">@_selectedPath.Title</div>
                    <button class="close-btn" @onclick="ClearSelection">&times;</button>
                </div>

                <div class="detail-taxonomy" style="background: @taxonomyColor.Item1; color: @taxonomyColor.Item2">
                    @FormatEnumName(_selectedPath.Taxonomy).ToUpperInvariant()
                </div>

                <div class="detail-meta-grid">
                    <div class="detail-meta-item">
                        <div class="meta-label">Status</div>
                        <div class="meta-value" style="color: @statusColor">@FormatEnumName(_selectedPath.Status)</div>
                    </div>
                    <div class="detail-meta-item">
                        <div class="meta-label">Complexity</div>
                        <div class="meta-value">Ring @_selectedPath.Ring</div>
                    </div>
                    <div class="detail-meta-item">
                        <div class="meta-label">Barrier Type</div>
                        <div class="meta-value" style="color: @quadrantInfo.Item2">@quadrantInfo.Item1</div>
                    </div>
                    @if (!string.IsNullOrEmpty(_selectedPath.Paper) && _selectedPath.Paper != "N/A")
                    {
                        <div class="detail-meta-item">
                            <div class="meta-label">Paper</div>
                            <div class="meta-value">@_selectedPath.Paper</div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_selectedPath.IssueUrl))
                {
                    <a href="@_selectedPath.IssueUrl" target="_blank" rel="noopener noreferrer" class="issue-link">
                        <i class="fab fa-github"></i> View Issue @_selectedPath.IssueNum
                    </a>
                }

                <div class="detail-section">
                    <div class="section-label">Description</div>
                    <div class="section-text">@_selectedPath.Description</div>
                </div>

                <div class="detail-section barrier">
                    <div class="section-label">Why It Stalled</div>
                    <div class="section-text">@_selectedPath.Barrier</div>
                </div>

                @if (!string.IsNullOrEmpty(_selectedPath.Unblock))
                {
                    <div class="detail-section unblock">
                        <div class="section-label">What Would Unblock</div>
                        <div class="section-text">@_selectedPath.Unblock</div>
                    </div>
                }

                @if (_selectedPath.Related.Count > 0)
                {
                    <div class="detail-section">
                        <div class="section-label">Related Concepts</div>
                        <div class="related-tags">
                            @foreach (var tag in _selectedPath.Related)
                            {
                                <span class="related-tag" @onclick="@(() => SearchRelated(tag))">@tag</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="details-empty">
                    <div class="empty-icon">🔍</div>
                    <div class="empty-text">Click a @(_viewMode == ViewMode.Cards ? "card" : "node") to explore</div>
                </div>
            }
        </aside>
    </div>

    <!-- Insight Box -->
    <div class="insight-box">
        <div class="insight-title">Key Insight</div>
        <div class="insight-text">
            Research paths fail primarily due to <strong>data access barriers</strong> ($10K+ feeds) or
            <strong>scope creep</strong> (production vs research). Technical infeasibility is rare.
            The validated core (71.5% detection) proves <strong>LLMs reason about structure</strong>, not just memorize.
        </div>
    </div>

    <!-- Modal popup for radar view -->
    @if (_viewMode == ViewMode.Radar)
    {
        <RadarModal Path="@_selectedPath"
                    OnClose="ClearSelection"
                    OnRelatedClick="SearchRelated" />
    }
</div>

@code {
    private ResearchQuadrant? _barrierFilter;
    private ResearchStatus? _statusFilter;
    private int? _ringFilter;
    private ResearchPath? _selectedPath;
    private ResearchPath? _hoveredPath;
    private string? _searchTerm;
    private ViewMode _viewMode = ViewMode.Cards;

    private enum ViewMode { Cards, Radar }

    private void ToggleViewMode() =>
        _viewMode = _viewMode == ViewMode.Cards ? ViewMode.Radar : ViewMode.Cards;

    private void HandleNodeHover(ResearchPath? path)
    {
        _hoveredPath = path;
    }

    private IEnumerable<ResearchPath> GetFilteredPaths()
    {
        var paths = ResearchPathData.Paths.AsEnumerable();

        if (_barrierFilter != null)
        {
            paths = paths.Where(p => p.BarrierQuadrant == _barrierFilter || p.Quadrant == _barrierFilter);
        }

        if (_statusFilter != null)
        {
            paths = paths.Where(p => p.Status == _statusFilter);
        }

        if (_ringFilter != null)
        {
            paths = paths.Where(p => p.Ring == _ringFilter);
        }

        if (!string.IsNullOrEmpty(_searchTerm))
        {
            paths = paths.Where(p =>
                p.Title.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Related.Any(r => r.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)));
        }

        return paths;
    }

    private void SetBarrierFilter(ResearchQuadrant? filter)
    {
        _barrierFilter = filter;
    }

    private void ToggleStatusFilter(ResearchStatus status)
    {
        _statusFilter = _statusFilter == status ? null : status;
    }

    private void ToggleRingFilter(int ring)
    {
        _ringFilter = _ringFilter == ring ? null : ring;
    }

    private void SelectPath(ResearchPath path)
    {
        _selectedPath = _selectedPath?.Id == path.Id ? null : path;
    }

    private void ClearSelection()
    {
        _selectedPath = null;
    }

    private void SearchRelated(string term)
    {
        _searchTerm = term;
        _selectedPath = null;
    }

    private static string FormatEnumName<T>(T enumValue) where T : Enum
    {
        var name = enumValue.ToString();
        // Insert spaces before uppercase letters (camelCase to words)
        return System.Text.RegularExpressions.Regex.Replace(name, "(?<!^)([A-Z])", " $1");
    }
}
