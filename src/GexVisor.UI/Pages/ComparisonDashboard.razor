@page "/comparison"
@using GexVisor.UI.Services
@using GexVisor.UI.Models
@using GexVisor.UI.Components.Comparison
@using GexVisor.UI.Components.Gex
@using GexVisor.UI.Utilities
@using System.Text
@using System.Text.Json
@inject ComparisonService ComparisonService
@inject ComparisonAnalysisService AnalysisService
@inject IGexDataService DataService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Cross-Asset Comparison - GexVisor</PageTitle>

<div class="comparison-page">
    <header class="page-header">
        <div class="header-left">
            <a href="/" class="back-link" title="Back to Home">
                <i class="fas fa-arrow-left"></i> Home
            </a>
            <h1>Cross-Asset Comparison</h1>
        </div>
        <div class="header-actions">
            @if (_summary != null)
            {
                <button class="btn-secondary" @onclick="ClearComparison">
                    <i class="fas fa-times"></i> Clear
                </button>
                <div class="export-dropdown">
                    <button class="btn-primary" @onclick="ToggleExportMenu">
                        <i class="fas fa-download"></i> Export <i class="fas fa-caret-down"></i>
                    </button>
                    @if (_showExportMenu)
                    {
                        <div class="export-menu">
                            <button class="export-option" @onclick="() => ExportAsJson()">
                                <i class="fas fa-file-code"></i> Export as JSON
                            </button>
                            <button class="export-option" @onclick="() => ExportAsCsv()">
                                <i class="fas fa-file-csv"></i> Export as CSV
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </header>

    @if (_summary == null)
    {
        <!-- Symbol Selection Mode -->
        <div class="selection-container">
            <div class="selection-header">
                <h2>Select 2-4 Assets to Compare</h2>
                <p class="subtitle">Compare GEX profiles, regime patterns, and correlations across multiple assets</p>
            </div>

            @if (_availableSymbols != null && _assetClasses != null)
            {
                <div class="symbol-grid">
                    @foreach (var assetClass in _assetClasses)
                    {
                        var symbols = _availableSymbols.Where(s => s.AssetClass == assetClass).ToList();
                        if (symbols.Any())
                        {
                            <div class="asset-class-section">
                                <h3 class="asset-class-title">@assetClass</h3>
                                <div class="symbol-list">
                                    @foreach (var symbolInfo in symbols)
                                    {
                                        var isSelected = ComparisonService.IsSymbolSelected(symbolInfo.Symbol);
                                        var isDisabled = !isSelected && ComparisonService.SelectionCount >= 4;

                                        <label class="symbol-checkbox @(isSelected ? "selected" : "") @(isDisabled ? "disabled" : "")">
                                            <input type="checkbox"
                                                   checked="@isSelected"
                                                   disabled="@isDisabled"
                                                   @onchange="@(() => ToggleSymbol(symbolInfo.Symbol))" />
                                            <div class="symbol-card">
                                                <div class="symbol-name">@symbolInfo.Symbol</div>
                                                <div class="symbol-meta">
                                                    <span>@symbolInfo.Count days</span>
                                                    <span>@symbolInfo.Start to @symbolInfo.End</span>
                                                </div>
                                            </div>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="selection-footer">
                    <div class="selection-status">
                        <span class="selection-count">
                            @ComparisonService.SelectionCount / 4 selected
                        </span>
                        @if (ComparisonService.GetValidationMessage() is string msg)
                        {
                            <span class="validation-message">@msg</span>
                        }
                    </div>
                    <button class="btn-primary btn-large"
                            disabled="@(!ComparisonService.IsValidSelection || _isLoading)"
                            @onclick="LoadComparison">
                        @if (_isLoading)
                        {
                            <text><i class="fas fa-spinner fa-spin"></i> Loading...</text>
                        }
                        else
                        {
                            <text><i class="fas fa-chart-bar"></i> Compare Selected Assets</text>
                        }
                    </button>
                </div>
            }
            else
            {
                <div class="loading-state">
                    <i class="fas fa-spinner fa-spin"></i>
                    <span>Loading available symbols...</span>
                </div>
            }

            @if (_loadError != null)
            {
                <div class="error-message">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@_loadError</span>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Comparison Results Mode -->
        <div class="comparison-container">
            <!-- Date Range Info -->
            <div class="comparison-info">
                <div class="info-card">
                    <i class="fas fa-calendar"></i>
                    <div>
                        <div class="info-label">Comparison Period</div>
                        <div class="info-value">@_summary.CommonDateRange.Start → @_summary.CommonDateRange.End (@_summary.CommonDateRange.TotalDays days)</div>
                    </div>
                </div>

                @if (!_summary.CommonDateRange.IsSufficient)
                {
                    <div class="info-card warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>
                            <div class="info-label">Limited Overlap</div>
                            <div class="info-value">@_summary.CommonDateRange.WarningMessage</div>
                        </div>
                    </div>
                }

                <div class="info-card">
                    <i class="fas fa-layer-group"></i>
                    <div>
                        <div class="info-label">Assets Compared</div>
                        <div class="info-value">@string.Join(", ", _summary.Assets.Select(a => a.Symbol))</div>
                    </div>
                </div>
            </div>

            <!-- Asset Cards Grid -->
            <div class="assets-grid">
                @foreach (var asset in _summary.Assets)
                {
                    <div class="asset-card">
                        <div class="asset-card-header">
                            <h3>@asset.Symbol</h3>
                            <span class="asset-class-badge">@asset.Timeline.AssetClass</span>
                        </div>
                        <div class="asset-metrics">
                            <div class="metric">
                                <span class="metric-label">Positive Gamma</span>
                                <span class="metric-value positive">@asset.RegimeAnalysis.PositiveGammaPercent%</span>
                            </div>
                            <div class="metric">
                                <span class="metric-label">Transitions</span>
                                <span class="metric-value">@asset.RegimeAnalysis.TotalTransitions</span>
                            </div>
                            <div class="metric">
                                <span class="metric-label">Avg Duration</span>
                                <span class="metric-value">@asset.RegimeAnalysis.AverageRegimeDuration.ToString("F1") days</span>
                            </div>
                            <div class="metric">
                                <span class="metric-label">Longest Streak</span>
                                <span class="metric-value">@Math.Max(asset.RegimeAnalysis.LongestPositiveStreak, asset.RegimeAnalysis.LongestNegativeStreak) days</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Summary Stats -->
            <div class="correlation-summary">
                <h2>Summary Statistics</h2>
                <div class="correlation-cards">
                    <div class="correlation-card">
                        <div class="correlation-value @CorrelationHelpers.GetCssClass(_summary.AvgPriceCorrelation)">
                            @_summary.AvgPriceCorrelation.ToString("F2")
                        </div>
                        <div class="correlation-label">Avg Price Correlation</div>
                    </div>
                    <div class="correlation-card">
                        <div class="correlation-value @CorrelationHelpers.GetCssClass(_summary.AvgGexCorrelation)">
                            @_summary.AvgGexCorrelation.ToString("F2")
                        </div>
                        <div class="correlation-label">Avg GEX Correlation</div>
                    </div>
                    <div class="correlation-card">
                        <div class="correlation-value">
                            @_summary.AvgRegimeAlignment.ToString("F1")%
                        </div>
                        <div class="correlation-label">Regime Alignment</div>
                    </div>
                    @if (_summary.DispersionScore.HasValue)
                    {
                        <div class="correlation-card">
                            <div class="correlation-value dispersion">
                                @_summary.DispersionScore.Value.ToString("F1")
                            </div>
                            <div class="correlation-label">Dispersion Score</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Correlation Matrix -->
            <CorrelationMatrix Correlations="_summary.Correlations" />

            <!-- Regime Charts Grid -->
            <div class="regime-charts-section">
                <h2>Regime Timelines</h2>
                <div class="regime-charts-grid" style="--chart-count: @(_summary.Assets.Count);">
                    @foreach (var asset in _summary.Assets)
                    {
                        <RegimeTimeline Analysis="asset.RegimeAnalysis" CompactMode="true" Symbol="asset.Symbol" />
                    }
                </div>
            </div>

            <!-- Divergence Events -->
            <RegimeDivergenceList Events="_summary.DivergenceEvents" />
        </div>
    }
</div>

@code {
    private List<SymbolInfo>? _availableSymbols;
    private List<string>? _assetClasses;
    private CrossAssetSummary? _summary;
    private bool _isLoading;
    private string? _loadError;
    private bool _showExportMenu;

    protected override async Task OnInitializedAsync()
    {
        ComparisonService.OnSelectionChanged += OnSelectionChanged;

        // Load index
        var index = await DataService.LoadIndexAsync();
        if (index != null)
        {
            _availableSymbols = index.Symbols;
            _assetClasses = index.AssetClasses.Keys.ToList();
        }
    }

    private void ToggleSymbol(string symbol)
    {
        ComparisonService.ToggleSymbol(symbol);
    }

    private async Task LoadComparison()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            var success = await ComparisonService.LoadSymbolsAsync(
                ComparisonService.SelectedSymbols.ToList());

            if (success)
            {
                _summary = AnalysisService.GenerateSummary(
                    ComparisonService.LoadedAssets.Values.ToList());
            }
            else
            {
                _loadError = "Failed to load some symbols. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Error: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ClearComparison()
    {
        _summary = null;
        ComparisonService.ClearSelection();
    }

    private void ToggleExportMenu()
    {
        _showExportMenu = !_showExportMenu;
    }

    private async Task ExportAsJson()
    {
        if (_summary == null)
        {
            return;
        }

        _showExportMenu = false;

        var json = JsonSerializer.Serialize(_summary, new JsonSerializerOptions
        {
            WriteIndented = true
        });

        var fileName = $"cross-asset-comparison_{DateTime.Now:yyyyMMdd_HHmmss}.json";
        await DownloadFile(fileName, json, "application/json");
    }

    private async Task ExportAsCsv()
    {
        if (_summary == null)
        {
            return;
        }

        _showExportMenu = false;

        var csv = new StringBuilder();

        // Header
        csv.AppendLine("Cross-Asset Comparison Export");
        csv.AppendLine($"Exported: {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
        csv.AppendLine($"Date Range: {_summary.CommonDateRange.Start} to {_summary.CommonDateRange.End}");
        csv.AppendLine($"Assets: {string.Join(", ", _summary.Assets.Select(a => a.Symbol))}");
        csv.AppendLine();

        // Summary Statistics
        csv.AppendLine("Summary Statistics");
        csv.AppendLine("Metric,Value");
        csv.AppendLine($"Avg Price Correlation,{_summary.AvgPriceCorrelation:F3}");
        csv.AppendLine($"Avg GEX Correlation,{_summary.AvgGexCorrelation:F3}");
        csv.AppendLine($"Avg Regime Alignment,{_summary.AvgRegimeAlignment:F1}%");
        if (_summary.DispersionScore.HasValue)
        {
            csv.AppendLine($"Dispersion Score,{_summary.DispersionScore.Value:F2}");
        }
        csv.AppendLine();

        // Pairwise Correlations
        csv.AppendLine("Pairwise Correlations");
        csv.AppendLine("Symbol 1,Symbol 2,Price Corr,GEX Corr,Regime Align %,Flip Sync %,Dispersion");
        foreach (var corr in _summary.Correlations)
        {
            csv.AppendLine($"{corr.Symbol1},{corr.Symbol2},{corr.PriceCorrelation:F3},{corr.GexCorrelation:F3},{corr.RegimeAlignment:F1},{corr.RegimeFlipCorrelation:F1},{corr.PerformanceDispersion:F2}");
        }
        csv.AppendLine();

        // Asset Details
        csv.AppendLine("Asset Details");
        csv.AppendLine("Symbol,Asset Class,Positive Gamma %,Negative Gamma %,Transitions,Avg Duration,Longest +γ Streak,Longest -γ Streak");
        foreach (var asset in _summary.Assets)
        {
            csv.AppendLine($"{asset.Symbol},{asset.Timeline.AssetClass},{asset.RegimeAnalysis.PositiveGammaPercent},{asset.RegimeAnalysis.NegativeGammaPercent},{asset.RegimeAnalysis.TotalTransitions},{asset.RegimeAnalysis.AverageRegimeDuration:F1},{asset.RegimeAnalysis.LongestPositiveStreak},{asset.RegimeAnalysis.LongestNegativeStreak}");
        }

        var fileName = $"cross-asset-comparison_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        await DownloadFile(fileName, csv.ToString(), "text/csv");
    }

    private async Task DownloadFile(string fileName, string content, string mimeType)
    {
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, content, mimeType);
    }

    private void OnSelectionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ComparisonService.OnSelectionChanged -= OnSelectionChanged;
    }
}
