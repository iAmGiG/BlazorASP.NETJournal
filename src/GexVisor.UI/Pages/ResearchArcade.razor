@page "/arcade"
@using GexVisor.UI.Components.Research
@using GexVisor.UI.Models
@using GexVisor.UI.Services
@using Microsoft.AspNetCore.Components.Web
@inject IResearchPathService ResearchPathService

<PageTitle>Research Arcade - GexVisor</PageTitle>

<div class="arcade-page">
    <header class="arcade-header">
        <a href="/" class="back-link" title="Back to Home">
            <i class="fas fa-arrow-left"></i> Home
        </a>
        <div class="header-content">
            <h1>Research Arcade</h1>
            <p class="tagline">Interactive Visualizations of Research Endeavors</p>
        </div>
    </header>

    <section class="metrics-banner">
        <div class="metric">
            <span class="metric-value">71.5%</span>
            <span class="metric-label">Detection Rate</span>
        </div>
        <div class="metric">
            <span class="metric-value">91.2%</span>
            <span class="metric-label">Accuracy</span>
        </div>
        <div class="metric">
            <span class="metric-value">242</span>
            <span class="metric-label">Trading Days</span>
        </div>
        <div class="metric">
            <span class="metric-value">15</span>
            <span class="metric-label">Patterns</span>
        </div>
    </section>

    <section class="validation-section">
        <PatternValidationTracker />
    </section>

    <!-- Hero Radar Section -->
    <section class="hero-radar-section">
        <div class="hero-radar-container">
            <h2 class="hero-title">Research Complexity Map</h2>
            <p class="hero-subtitle">
                Interactive visualization of 16 research paths by barrier type and complexity
            </p>

            <div class="radar-wrapper" tabindex="0" @onkeydown="HandleKeyDown">
                <InteractiveRadar Size="500"
                                  ShowLabels="true"
                                  Paths="@_paths"
                                  SelectedPathId="@_selectedPath?.Id"
                                  FocusedPathId="@_focusedPath?.Id"
                                  OnNodeClick="SelectPath"
                                  OnFocusChange="HandleFocusChange" />

                <ConnectionLines SelectedPath="@_selectedPath"
                                 AllPaths="@_paths"
                                 Size="500" />
            </div>

            <div class="keyboard-hints">
                <span class="hint"><kbd>←→</kbd> Navigate</span>
                <span class="hint"><kbd>Enter</kbd> Select</span>
                <span class="hint"><kbd>Esc</kbd> Close</span>
            </div>
        </div>
    </section>

    <!-- Modal popup for hero radar -->
    @if (_selectedPath != null)
    {
        <RadarModal Path="@_selectedPath"
                    OnClose="ClearSelection"
                    OnRelatedClick="@(_ => {})" />
    }

    <div class="arcade-grid">
        <a href="/research/complexity" class="arcade-card featured">
            <div class="card-icon map">
                <i class="fas fa-project-diagram"></i>
            </div>
            <div class="card-content">
                <h2>Research Complexity Map</h2>
                <p>Interactive radar visualization mapping 16 research paths by barrier type, complexity level, and status. Toggle between card and radar views.</p>
                <div class="card-tags">
                    <span class="tag">Radar View</span>
                    <span class="tag">16 Paths</span>
                    <span class="tag">Interactive</span>
                </div>
            </div>
        </a>

        <a href="/gex" class="arcade-card">
            <div class="card-icon gamma">@GammaSymbol</div>
            <div class="card-content">
                <h2>GEX Visualizer</h2>
                <p>Interactive Blazor WebAssembly application for exploring GEX regime dynamics with real-time state management and dual-view comparisons.</p>
                <div class="card-tags">
                    <span class="tag">.NET 10</span>
                    <span class="tag">Blazor WASM</span>
                    <span class="tag">Interactive</span>
                </div>
            </div>
        </a>

        <a href="/research/regime-evolution" class="arcade-card">
            <div class="card-icon regime">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="card-content">
                <h2>Regime Evolution</h2>
                <p>30-day regime detection visualization showing how 0DTE proliferation transformed market structure from fragmented (2020: 12%) to persistent regimes (2024: 100%).</p>
                <div class="card-tags">
                    <span class="tag">0DTE</span>
                    <span class="tag">30-Day Windows</span>
                    <span class="tag">Detection</span>
                </div>
            </div>
        </a>

        <a href="https://github.com/iAmGiG/GexVisor/blob/development/docs/RESEARCH_ROADMAP.md" target="_blank" class="arcade-card">
            <div class="card-icon roadmap">
                <i class="fas fa-route"></i>
            </div>
            <div class="card-content">
                <h2>Research Roadmap</h2>
                <p>Strategic multi-phase research trajectory: from static detection to cross-asset generalization, intraday mechanics, and neuro-symbolic simulation.</p>
                <div class="card-tags">
                    <span class="tag">Strategy</span>
                    <span class="tag">Phase 3-4</span>
                    <span class="tag">ABM</span>
                </div>
            </div>
        </a>

        <a href="/research/patterns" class="arcade-card">
            <div class="card-icon mining">
                <i class="fas fa-search"></i>
            </div>
            <div class="card-content">
                <h2>Pattern Discovery Pipeline</h2>
                <p>Data mining KDD process visualization: from raw data to actionable patterns through selection, preprocessing, transformation, and interpretation.</p>
                <div class="card-tags">
                    <span class="tag">KDD</span>
                    <span class="tag">Data Mining</span>
                    <span class="tag">Educational</span>
                </div>
            </div>
        </a>

        <a href="/research/pipeline" class="arcade-card">
            <div class="card-icon pipeline">
                <i class="fas fa-stream"></i>
            </div>
            <div class="card-content">
                <h2>Data Pipeline States</h2>
                <p>Interactive state diagram showing data flow from raw sources through storage, processing, and output stages with transition conditions.</p>
                <div class="card-tags">
                    <span class="tag">State Machine</span>
                    <span class="tag">Pipeline</span>
                    <span class="tag">Architecture</span>
                </div>
            </div>
        </a>
    </div>

    <section class="research-phases">
        <h2>Research Phases</h2>
        <div class="phase-list">
            <div class="phase completed">
                <span class="phase-num">1</span>
                <div class="phase-content">
                    <strong>Obfuscation Testing</strong>
                    <p>Can LLMs detect gamma patterns without temporal cues? (Validated: 71.5% detection)</p>
                </div>
            </div>
            <div class="phase current">
                <span class="phase-num">2</span>
                <div class="phase-content">
                    <strong>Temporal Dynamics</strong>
                    <p>Can LLMs perceive regime evolution over time?</p>
                </div>
            </div>
            <div class="phase planned">
                <span class="phase-num">3</span>
                <div class="phase-content">
                    <strong>Cross-Asset Generalization</strong>
                    <p>Index vs. single-stock dynamics, intraday mechanics, "Scar Tissue" hypothesis</p>
                </div>
            </div>
            <div class="phase planned">
                <span class="phase-num">4</span>
                <div class="phase-content">
                    <strong>Neuro-Symbolic Simulation</strong>
                    <p>Agent-based modeling, GNN contagion networks, causal discovery</p>
                </div>
            </div>
        </div>
    </section>

    <footer class="arcade-footer">
        <p>Part of <a href="https://github.com/iAmGiG/gex-llm-patterns" target="_blank">GEX-LLM Patterns</a> research project</p>
    </footer>
</div>

@code {
    private const string GammaSymbol = "\u0393";

    private ResearchPath[] _paths = [];
    private ResearchPath? _selectedPath;
    private ResearchPath? _focusedPath;

    protected override async Task OnInitializedAsync()
    {
        _paths = await ResearchPathService.LoadPathsAsync();
    }

    private void SelectPath(ResearchPath path)
    {
        _selectedPath = _selectedPath?.Id == path.Id ? null : path;
    }

    private void ClearSelection()
    {
        _selectedPath = null;
    }

    private void HandleFocusChange(ResearchPath? path)
    {
        _focusedPath = path;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (_paths.Length == 0) return;

        // Find current focus index
        var currentIndex = _focusedPath != null
            ? Array.FindIndex(_paths, p => p.Id == _focusedPath.Id)
            : -1;

        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
                currentIndex = (currentIndex + 1) % _paths.Length;
                _focusedPath = _paths[currentIndex];
                break;

            case "ArrowLeft":
            case "ArrowUp":
                currentIndex = currentIndex <= 0 ? _paths.Length - 1 : currentIndex - 1;
                _focusedPath = _paths[currentIndex];
                break;

            case "Enter":
            case " ": // Space
                if (_focusedPath != null)
                {
                    SelectPath(_focusedPath);
                }
                break;

            case "Escape":
                _focusedPath = null;
                _selectedPath = null;
                break;
        }
    }
}
