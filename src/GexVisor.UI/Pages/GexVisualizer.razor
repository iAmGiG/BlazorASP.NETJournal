@page "/gex"
@using GexVisor.UI.Services
@using GexVisor.UI.Models
@inject IJSRuntime JS
@inject LocalStorageService Storage
@implements IDisposable

<PageTitle>GEX Visualizer</PageTitle>

<div class="gex-app" tabindex="0" @ref="_appRef" @onkeydown="HandleKeyDown" @onkeydown:preventDefault="@_preventKeyDefault">
    <GexHeader OnHelpRequested="ShowHelp" />

    <div class="gex-dashboard">
        <GexSidebar />

        <div class="chart-panels">
            <div class="chart-panel">
                <div class="panel-header">
                    <div>
                        <div class="panel-title">PRACTITIONER VIEW</div>
                        <div class="panel-subtitle">Normalized Ratio (Price-Independent)</div>
                    </div>
                    <div class="panel-status">
                        <div class="status-label">Signal Status</div>
                        <div class="status-value">@NormalizedStatus</div>
                    </div>
                </div>
                <div class="viz-container">
                    <GexChart IsAbsolute="false" />
                </div>
                <div class="data-overlay">
                    <div class="data-row"><span>Scale Factor:</span> <span class="data-val cyan">1.0x (Fixed)</span></div>
                    <div class="data-row"><span>Max Gamma:</span> <span class="data-val">@MaxGamma.ToString("F2")</span></div>
                </div>
            </div>

            <div class="chart-panel">
                <div class="panel-header">
                    <div>
                        <div class="panel-title red">PAPER 2 VIEW (ABSOLUTE)</div>
                        <div class="panel-subtitle">Dollar GEX (S² Scaled)</div>
                    </div>
                    <div class="panel-status">
                        <div class="status-label">Regime Detector</div>
                        <div class="status-value">@AbsoluteStatus</div>
                    </div>
                </div>
                <div class="viz-container">
                    <GexChart IsAbsolute="true" />
                </div>
                <div class="data-overlay">
                    <div class="data-row"><span>S² Scale:</span> <span class="data-val red">@S2Factor.ToString("F1")x</span></div>
                    <div class="data-row"><span>Total GEX:</span> <span class="data-val">@FormatGex(TotalGex)</span></div>
                </div>
            </div>
        </div>

        @if (_showRegimeTimeline && RegimeAnalysis != null)
        {
            <div class="regime-timeline-section">
                <RegimeTimeline Analysis="RegimeAnalysis" />
            </div>
        }
    </div>

    <button class="toggle-timeline-btn @(_showRegimeTimeline ? "active" : "")"
            @onclick="ToggleRegimeTimeline"
            title="@(_showRegimeTimeline ? "Hide" : "Show") Regime Timeline">
        <i class="fas fa-chart-bar"></i>
        <span>@(_showRegimeTimeline ? "Hide" : "Show") Timeline</span>
    </button>
</div>

<KeyboardShortcutsOverlay IsVisible="_showHelp" OnClose="HideHelp" />
<AnnotationPanel />

@code {
    [Inject] private GexStateService StateService { get; set; } = default!;

    private ElementReference _appRef;
    private bool _preventKeyDefault;
    private System.Timers.Timer? _saveTimer;
    private bool _settingsPending;
    private bool _showHelp;
    private bool _showRegimeTimeline;
    private RegimeAnalysisSummary? _regimeAnalysis;

    private RegimeAnalysisSummary? RegimeAnalysis => _regimeAnalysis ??= StateService.GetRegimeAnalysis();

    private decimal S2Factor => StateService.State.S2Factor;
    private decimal TotalGex => StateService.State.CurrentDataPoint?.Gex ?? 0;
    private decimal MaxGamma => StateService.State.CurrentDataPoint?.MaxGamma ?? 0;

    private string NormalizedStatus => StateService.State.CurrentDataPoint?.IsNegativeGamma == true
        ? "SHORT GAMMA" : "NEUTRAL";

    private string AbsoluteStatus => StateService.State.CurrentDataPoint?.IsNegativeGamma == true
        ? "NEGATIVE REGIME" : "NO REGIME";

    protected override void OnInitialized()
    {
        StateService.OnStateChanged += StateHasChanged;
        StateService.OnSettingsChanged += OnSettingsChanged;

        // Debounce timer for saving settings (500ms delay)
        _saveTimer = new System.Timers.Timer(500);
        _saveTimer.AutoReset = false;
        _saveTimer.Elapsed += async (s, e) => await SaveSettingsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load saved settings
            await LoadSettingsAsync();

            // Focus the app container to enable keyboard events
            await _appRef.FocusAsync();
        }
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var settings = await Storage.GetAsync<AppSettings>(StorageKeys.AppSettings);
            if (settings != null)
            {
                StateService.ApplySettings(settings);
            }
        }
        catch
        {
            // Ignore errors loading settings
        }
    }

    private void OnSettingsChanged()
    {
        // Debounce: restart the timer on each change
        _settingsPending = true;
        _saveTimer?.Stop();
        _saveTimer?.Start();
    }

    private async Task SaveSettingsAsync()
    {
        if (!_settingsPending) return;
        _settingsPending = false;

        try
        {
            var settings = StateService.GetSettings();
            await Storage.SetAsync(StorageKeys.AppSettings, settings);
        }
        catch
        {
            // Ignore errors saving settings
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        _preventKeyDefault = true;

        switch (e.Key)
        {
            case " ":
                if (!_showHelp) StateService.ToggleSimulation();
                break;
            case "ArrowRight":
                if (!_showHelp) StateService.StepForward();
                break;
            case "ArrowLeft":
                if (!_showHelp) StateService.StepBackward();
                break;
            case "ArrowUp":
                if (!_showHelp) JumpToNextYear();
                break;
            case "ArrowDown":
                if (!_showHelp) JumpToPrevYear();
                break;
            case "Home":
                if (!_showHelp) StateService.JumpToStart();
                break;
            case "End":
                if (!_showHelp) StateService.JumpToEnd();
                break;
            case "r":
            case "R":
                if (!_showHelp) StateService.ResetView();
                break;
            case "f":
            case "F":
                if (!_showHelp) await ToggleFullscreen();
                break;
            case "?":
                ToggleHelp();
                break;
            case "Escape":
                HideHelp();
                break;
            default:
                _preventKeyDefault = false;
                break;
        }
    }

    private void ShowHelp()
    {
        _showHelp = true;
    }

    private void HideHelp()
    {
        _showHelp = false;
    }

    private void ToggleHelp()
    {
        _showHelp = !_showHelp;
    }

    private void ToggleRegimeTimeline()
    {
        _showRegimeTimeline = !_showRegimeTimeline;
        if (_showRegimeTimeline)
        {
            // Invalidate cache to get fresh analysis
            _regimeAnalysis = null;
        }
    }

    private async Task ToggleFullscreen()
    {
        await JS.InvokeVoidAsync("GexInterop.toggleFullscreen");
    }

    private void JumpToNextYear()
    {
        var current = StateService.State.CurrentDataPoint;
        if (current == null) { StateService.JumpToStart(); return; }

        var currentYear = int.Parse(current.Date.Split('-')[0]);
        var timeline = StateService.Timeline;
        for (int i = 0; i < timeline.Count; i++)
        {
            if (int.Parse(timeline[i].Date.Split('-')[0]) > currentYear)
            {
                StateService.SetCurrentIndex(i);
                return;
            }
        }
    }

    private void JumpToPrevYear()
    {
        var current = StateService.State.CurrentDataPoint;
        if (current == null) { StateService.JumpToStart(); return; }

        var currentYear = int.Parse(current.Date.Split('-')[0]);
        var timeline = StateService.Timeline;
        for (int i = timeline.Count - 1; i >= 0; i--)
        {
            if (int.Parse(timeline[i].Date.Split('-')[0]) < currentYear)
            {
                StateService.SetCurrentIndex(i);
                return;
            }
        }
    }

    private static string FormatGex(decimal gex)
    {
        return gex switch
        {
            >= 1000 => $"${gex / 1000:F1}T",
            >= 1 => $"${gex:F1}B",
            _ => $"${gex * 1000:F0}M"
        };
    }

    public void Dispose()
    {
        StateService.OnStateChanged -= StateHasChanged;
        StateService.OnSettingsChanged -= OnSettingsChanged;
        _saveTimer?.Stop();
        _saveTimer?.Dispose();
    }
}
