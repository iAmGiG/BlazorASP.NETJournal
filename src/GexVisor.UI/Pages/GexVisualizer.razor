@page "/gex"
@using GexVisor.UI.Services
@implements IDisposable

<PageTitle>GEX Visualizer</PageTitle>

<div class="gex-app" tabindex="0" @ref="_appRef" @onkeydown="HandleKeyDown" @onkeydown:preventDefault="@_preventKeyDefault">
    <GexHeader />

    <div class="gex-dashboard">
        <GexSidebar />

        <div class="chart-panels">
            <div class="chart-panel">
                <div class="panel-header">
                    <div>
                        <div class="panel-title">PRACTITIONER VIEW</div>
                        <div class="panel-subtitle">Normalized Ratio (Price-Independent)</div>
                    </div>
                    <div class="panel-status">
                        <div class="status-label">Signal Status</div>
                        <div class="status-value">@NormalizedStatus</div>
                    </div>
                </div>
                <div class="viz-container">
                    <GexChart IsAbsolute="false" />
                </div>
                <div class="data-overlay">
                    <div class="data-row"><span>Scale Factor:</span> <span class="data-val cyan">1.0x (Fixed)</span></div>
                    <div class="data-row"><span>Max Gamma:</span> <span class="data-val">@MaxGamma.ToString("F2")</span></div>
                </div>
            </div>

            <div class="chart-panel">
                <div class="panel-header">
                    <div>
                        <div class="panel-title red">PAPER 2 VIEW (ABSOLUTE)</div>
                        <div class="panel-subtitle">Dollar GEX (S² Scaled)</div>
                    </div>
                    <div class="panel-status">
                        <div class="status-label">Regime Detector</div>
                        <div class="status-value">@AbsoluteStatus</div>
                    </div>
                </div>
                <div class="viz-container">
                    <GexChart IsAbsolute="true" />
                </div>
                <div class="data-overlay">
                    <div class="data-row"><span>S² Scale:</span> <span class="data-val red">@S2Factor.ToString("F1")x</span></div>
                    <div class="data-row"><span>Total GEX:</span> <span class="data-val">@FormatGex(TotalGex)</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private GexStateService StateService { get; set; } = default!;

    private ElementReference _appRef;
    private bool _preventKeyDefault;

    private decimal S2Factor => StateService.State.S2Factor;
    private decimal TotalGex => StateService.State.CurrentDataPoint?.Gex ?? 0;
    private decimal MaxGamma => StateService.State.CurrentDataPoint?.MaxGamma ?? 0;

    private string NormalizedStatus => StateService.State.CurrentDataPoint?.IsNegativeGamma == true
        ? "SHORT GAMMA" : "NEUTRAL";

    private string AbsoluteStatus => StateService.State.CurrentDataPoint?.IsNegativeGamma == true
        ? "NEGATIVE REGIME" : "NO REGIME";

    protected override void OnInitialized()
    {
        StateService.OnStateChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Focus the app container to enable keyboard events
            await _appRef.FocusAsync();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        _preventKeyDefault = true;

        switch (e.Key)
        {
            case " ":
                StateService.ToggleSimulation();
                break;
            case "ArrowRight":
                StateService.StepForward();
                break;
            case "ArrowLeft":
                StateService.StepBackward();
                break;
            case "ArrowUp":
                JumpToNextYear();
                break;
            case "ArrowDown":
                JumpToPrevYear();
                break;
            case "Home":
                StateService.JumpToStart();
                break;
            case "End":
                StateService.JumpToEnd();
                break;
            default:
                _preventKeyDefault = false;
                break;
        }
    }

    private void JumpToNextYear()
    {
        var current = StateService.State.CurrentDataPoint;
        if (current == null) { StateService.JumpToStart(); return; }

        var currentYear = int.Parse(current.Date.Split('-')[0]);
        var timeline = StateService.Timeline;
        for (int i = 0; i < timeline.Count; i++)
        {
            if (int.Parse(timeline[i].Date.Split('-')[0]) > currentYear)
            {
                StateService.SetCurrentIndex(i);
                return;
            }
        }
    }

    private void JumpToPrevYear()
    {
        var current = StateService.State.CurrentDataPoint;
        if (current == null) { StateService.JumpToStart(); return; }

        var currentYear = int.Parse(current.Date.Split('-')[0]);
        var timeline = StateService.Timeline;
        for (int i = timeline.Count - 1; i >= 0; i--)
        {
            if (int.Parse(timeline[i].Date.Split('-')[0]) < currentYear)
            {
                StateService.SetCurrentIndex(i);
                return;
            }
        }
    }

    private static string FormatGex(decimal gex)
    {
        return gex switch
        {
            >= 1000 => $"${gex / 1000:F1}T",
            >= 1 => $"${gex:F1}B",
            _ => $"${gex * 1000:F0}M"
        };
    }

    public void Dispose()
    {
        StateService.OnStateChanged -= StateHasChanged;
    }
}
