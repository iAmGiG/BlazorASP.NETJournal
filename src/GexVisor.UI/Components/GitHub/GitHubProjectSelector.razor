@namespace GexVisor.UI.Components.GitHub
@using GexVisor.UI.Models
@using GexVisor.UI.Services
@inject GitHubAuthService AuthService
@inject GitHubProjectService ProjectService
@implements IDisposable

<div class="project-selector">
    @if (!AuthService.IsAuthenticated)
    {
        <div class="not-authenticated">
            <i class="fab fa-github"></i>
            <span>Connect to GitHub to select a project</span>
        </div>
    }
    else if (_isLoading)
    {
        <div class="loading">
            <span class="spinner"></span>
            <span>Loading projects...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-message">
            <i class="fas fa-exclamation-circle"></i>
            <span>@_error</span>
            <button class="btn-close" @onclick="ClearError" title="Dismiss"><i class="fas fa-times"></i></button>
        </div>
    }
    else if (ProjectService.SelectedProject != null)
    {
        <div class="selected-project">
            <div class="project-info">
                <span class="project-title">@ProjectService.SelectedProject.Title</span>
                <span class="project-items">@ProjectService.SelectedProject.ItemCount items</span>
            </div>
            <div class="project-actions">
                <button class="btn-refresh" @onclick="RefreshProjects" title="Refresh">
                    <i class="fas fa-sync-alt"></i>
                </button>
                <button class="btn-change" @onclick="ChangeProject" title="Change project">
                    <i class="fas fa-exchange-alt"></i>
                </button>
            </div>
        </div>
    }
    else if (ProjectService.Projects.Count > 0)
    {
        <div class="project-list">
            <div class="list-header">
                <span>Select a Project</span>
                <button class="btn-refresh" @onclick="RefreshProjects" title="Refresh">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
            @foreach (var project in ProjectService.Projects)
            {
                <div class="project-item" @onclick="() => SelectProject(project.Id)">
                    <div class="project-name">@project.Title</div>
                    @if (!string.IsNullOrEmpty(project.Description))
                    {
                        <div class="project-desc">@project.Description</div>
                    }
                    <div class="project-meta">
                        <span>@project.ItemCount items</span>
                        @if (project.StatusField != null)
                        {
                            <span class="has-status">
                                <i class="fas fa-columns"></i>
                                @project.StatusField.Options.Count columns
                            </span>
                        }
                    </div>
                </div>
            }
            @if (ProjectService.HasMoreProjects)
            {
                <div class="load-more-container">
                    @if (_isLoadingMore)
                    {
                        <div class="loading-more">
                            <span class="spinner"></span>
                            <span>Loading more projects...</span>
                        </div>
                    }
                    else
                    {
                        <button class="btn-load-more" @onclick="LoadMoreProjects">
                            <i class="fas fa-chevron-down"></i>
                            Load More Projects
                        </button>
                    }
                </div>
            }

            @OrgSelector(showMyProjectsLink: true)
        </div>
    }
    else
    {
        <div class="no-projects">
            <span>No projects found</span>
            <button class="btn-fetch" @onclick="RefreshProjects">
                <i class="fas fa-sync-alt"></i> Fetch Projects
            </button>

            @OrgSelector(showLabel: true)
        </div>
    }
</div>

@code {
    private bool _isLoading;
    private bool _isLoadingMore;
    private string? _error;
    private string _orgName = "";

    private RenderFragment OrgSelector(bool showLabel = false, bool showMyProjectsLink = false) => __builder =>
    {
        <div class="org-selector @(showLabel ? "mt-2" : "")">
            @if (showLabel)
            {
                <span>Or load from organization:</span>
            }
            <div class="org-input-group">
                <input @bind="_orgName" placeholder="Organization name" class="form-control" @onkeyup="HandleOrgKeyUp" />
                <button class="btn-fetch" @onclick="LoadOrgProjects" disabled="@string.IsNullOrWhiteSpace(_orgName)">
                    @(showMyProjectsLink ? "Load Org" : "Load")
                </button>
            </div>
            @if (showMyProjectsLink)
            {
                <button class="btn-link" @onclick="RefreshProjects">Load My Projects</button>
            }
            @if (ProjectService.RecentOrgs.Count > 0)
            {
                <div class="recent-orgs">
                    @foreach (var org in ProjectService.RecentOrgs)
                    {
                        <button class="recent-org-chip" @onclick="@(() => LoadRecentOrg(org))">@org</button>
                    }
                    <button class="btn-clear-history" @onclick="ClearRecentOrgs" title="Clear history">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            }
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthStateChanged += OnAuthChanged;
        ProjectService.OnProjectsChanged += OnProjectsChanged;
        ProjectService.OnError += OnProjectError;

        try
        {
            await ProjectService.LoadAsync();
            _orgName = ProjectService.CurrentOrg ?? "";

            // Auto-fetch if authenticated but no projects
            if (AuthService.IsAuthenticated && ProjectService.Projects.Count == 0)
            {
                await RefreshProjects();
            }
        }
        catch
        {
            // Ignore initialization errors
        }
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (AuthService.IsAuthenticated && ProjectService.Projects.Count == 0)
                {
                    await RefreshProjects();
                }
                StateHasChanged();
            }
            catch
            {
                // Ignore errors
            }
        });
    }

    private void OnProjectsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnProjectError(string error)
    {
        _error = error;
        _isLoading = false;
        _isLoadingMore = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshProjects()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            await ProjectService.FetchProjectsAsync();
        }
        catch
        {
            // Ignore fetch errors
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadOrgProjects()
    {
        if (string.IsNullOrWhiteSpace(_orgName)) return;

        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            await ProjectService.FetchOrganizationProjectsAsync(_orgName);
        }
        catch
        {
            // Ignore fetch errors
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task HandleOrgKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadOrgProjects();
        }
    }

    private async Task LoadRecentOrg(string org)
    {
        _orgName = org;
        await LoadOrgProjects();
    }

    private async Task ClearRecentOrgs()
    {
        await ProjectService.ClearRecentOrgsAsync();
    }

    private async Task SelectProject(string projectId)
    {
        await ProjectService.SelectProjectAsync(projectId);
    }

    private async Task ChangeProject()
    {
        await ProjectService.ClearSelectionAsync();
    }

    private async Task LoadMoreProjects()
    {
        _isLoadingMore = true;
        StateHasChanged();

        try
        {
            await ProjectService.FetchMoreProjectsAsync();
        }
        catch
        {
            // Ignore fetch errors
        }

        _isLoadingMore = false;
        StateHasChanged();
    }

    private void ClearError()
    {
        _error = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthChanged;
        ProjectService.OnProjectsChanged -= OnProjectsChanged;
        ProjectService.OnError -= OnProjectError;
    }
}
