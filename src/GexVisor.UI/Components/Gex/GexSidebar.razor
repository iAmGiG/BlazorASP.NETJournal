@using GexVisor.UI.Configuration
@using GexVisor.UI.Models
@using GexVisor.UI.Services
@inject IGexStateService StateService
@inject GexDataService DataService
@implements IDisposable

<div class="gex-sidebar" role="complementary" aria-label="GEX Controls and Information">
    <!-- Data Source Section -->
    <div class="section-title">Data Source</div>
    <div class="data-source-controls">
        <div class="data-mode-toggle" role="radiogroup" aria-label="Data source selection">
            <button class="mode-btn @(IsDemo ? "active" : "")" @onclick="() => SetMode(DataMode.Demo)" role="radio" aria-checked="@IsDemo" aria-label="Use demo data">Demo</button>
            <button class="mode-btn @(!IsDemo ? "active" : "")" @onclick="() => SetMode(DataMode.Real)" role="radio" aria-checked="@(!IsDemo)" aria-label="Use real market data">Real Data</button>
        </div>

        @if (!IsDemo)
        {
            <div class="symbol-selectors">
                <div class="selector-row">
                    <select @onchange="OnAssetClassChange" value="@SelectedAssetClass" aria-label="Select asset class">
                        <option value="">Select asset class...</option>
                        @foreach (var ac in AssetClasses)
                        {
                            <option value="@ac">@ac</option>
                        }
                    </select>
                </div>
                <div class="selector-row">
                    <select @onchange="OnSymbolChange" value="@SelectedSymbol" disabled="@string.IsNullOrEmpty(SelectedAssetClass)" aria-label="Select trading symbol">
                        <option value="">Select symbol...</option>
                        @foreach (var sym in Symbols)
                        {
                            <option value="@sym">@sym</option>
                        }
                    </select>
                </div>
                @if (SymbolInfo != null)
                {
                    <div class="data-info">@SymbolInfo.Count data points (@SymbolInfo.Start to @SymbolInfo.End)</div>
                }
            </div>
        }
    </div>

    <!-- Simulation Section -->
    <div class="section-title">Simulation</div>
    <div class="sim-controls">
        <div class="media-controls" role="group" aria-label="Playback controls">
            <button class="media-btn" @onclick="StateService.JumpToStart" title="Start (Home)" aria-label="Jump to start">⏮</button>
            <button class="media-btn" @onclick="JumpToPrevYear" title="Prev Year (↓)" aria-label="Jump to previous year">«</button>
            <button class="media-btn" @onclick="StateService.StepBackward" title="Step Back (←)" aria-label="Step backward">◀</button>
            <button class="media-btn play-btn @(IsSimulating ? "active" : "")" @onclick="StateService.ToggleSimulation" title="Play/Pause (Space)" aria-label="@(IsSimulating ? "Pause simulation" : "Play simulation")" aria-pressed="@IsSimulating">
                @(IsSimulating ? "⏸" : "▶")
            </button>
            <button class="media-btn" @onclick="StateService.StepForward" title="Step Fwd (→)" aria-label="Step forward">▶</button>
            <button class="media-btn" @onclick="JumpToNextYear" title="Next Year (↑)" aria-label="Jump to next year">»</button>
            <button class="media-btn" @onclick="StateService.JumpToEnd" title="End (End)" aria-label="Jump to end">⏭</button>
        </div>

        <div class="speed-control" role="radiogroup" aria-label="Playback speed">
            <button class="speed-btn @(PlaybackSpeed == 1 ? "active" : "")" @onclick="() => SetSpeed(1)" role="radio" aria-checked="@(PlaybackSpeed == 1)" aria-label="Half speed">0.5x</button>
            <button class="speed-btn @(PlaybackSpeed == 2 ? "active" : "")" @onclick="() => SetSpeed(2)" role="radio" aria-checked="@(PlaybackSpeed == 2)" aria-label="Normal speed">1x</button>
            <button class="speed-btn @(PlaybackSpeed == 4 ? "active" : "")" @onclick="() => SetSpeed(4)" role="radio" aria-checked="@(PlaybackSpeed == 4)" aria-label="Double speed">2x</button>
        </div>

        <div class="timeline-scrubber">
            <div class="timeline-track">
                <div class="timeline-progress" style="width: @ProgressPercent%" aria-hidden="true"></div>
                <input type="range" min="0" max="@MaxIndex" value="@CurrentIndex" @oninput="OnScrub" class="timeline-input" aria-label="Timeline position" aria-valuemin="0" aria-valuemax="@MaxIndex" aria-valuenow="@CurrentIndex" aria-valuetext="@EventDate" />
            </div>
        </div>

        <div class="current-event">
            <div class="event-date">@EventDate</div>
            <div class="event-label">@EventLabel</div>
            <div class="event-index">@(CurrentIndex >= 0 ? $"{CurrentIndex + 1}/{MaxIndex + 1}" : "--")</div>
        </div>
    </div>

    <!-- Price History Section -->
    <div class="section-title">Price History</div>
    <PriceSparkline Title="@SparklineTitle" />

    <!-- Parameters Section -->
    <div class="section-title" id="params-heading">Parameters</div>
    <div class="control-group" role="group" aria-labelledby="params-heading">
        <div class="control-label">
            <span id="price-label">Spot Price (@SymbolLabel)</span>
            <span class="control-value" aria-live="polite">$@Price.ToString("F0")</span>
        </div>
        <input type="range" min="@StrikeStart" max="@StrikeEnd" step="1" value="@Price" @oninput="OnPriceChange" aria-labelledby="price-label" aria-valuetext="$@Price.ToString("F0")" />
    </div>

    <div class="control-group">
        <div class="control-label">
            <span id="oi-label">Open Interest</span>
            <span class="control-value" aria-live="polite">@OpenInterest.ToString("F1")M</span>
        </div>
        <input type="range" min="3" max="12" step="0.1" value="@OpenInterest" @oninput="OnOiChange" aria-labelledby="oi-label" aria-valuetext="@OpenInterest.ToString("F1") million" />
    </div>

    <div class="control-group">
        <div class="control-label">
            <span id="tilt-label">Dealer Positioning</span>
            <span class="control-value" aria-live="polite">@Tilt.ToString("F2")</span>
        </div>
        <input type="range" min="-0.5" max="0.5" step="0.01" value="@Tilt" @oninput="OnTiltChange" aria-labelledby="tilt-label" aria-valuetext="@Tilt.ToString("F2")" />
    </div>

    <!-- Zero Gamma Section -->
    <div class="section-title">Zero Gamma Level</div>
    <div class="zero-gamma-card">
        <div class="zero-gamma-value">$@ZeroGamma.ToString("F0")</div>
        <div class="zero-gamma-label">Gamma Flip Point</div>
        <div class="gamma-flip-indicator">
            <span class="flip-zone flip-below">▲ Below: Long γ</span>
            <span class="flip-zone flip-above">▼ Above: Short γ</span>
        </div>
    </div>

    <!-- Keyboard Shortcuts Section -->
    <div class="section-title">Keyboard Shortcuts</div>
    <div class="shortcuts-list">
        <div class="shortcut-row"><span class="shortcut-key">Space</span><span class="shortcut-action">Play/Pause</span></div>
        <div class="shortcut-row"><span class="shortcut-key">← →</span><span class="shortcut-action">Step</span></div>
        <div class="shortcut-row"><span class="shortcut-key">↑ ↓</span><span class="shortcut-action">Jump Year</span></div>
        <div class="shortcut-row"><span class="shortcut-key">Home/End</span><span class="shortcut-action">Start/End</span></div>
        <div class="shortcut-row"><span class="shortcut-key">R</span><span class="shortcut-action">Reset Zoom</span></div>
        <div class="shortcut-row"><span class="shortcut-key">F</span><span class="shortcut-action">Fullscreen</span></div>
    </div>

    <!-- Regime Persistence Section -->
    <div class="section-title">Regime Persistence</div>
    <div class="persistence-card">
        <div class="persistence-meter">
            @for (int i = 0; i < 10; i++)
            {
                <div class="persistence-bar @(i < PersistenceBars ? "active" : "")"></div>
            }
        </div>
        <div class="persistence-stats">
            <span>Avg Duration: <strong>~8 days</strong></span>
            <span>@PersistenceLabel</span>
        </div>
    </div>

    <!-- Lead-Lag Signal Section -->
    <div class="section-title">Lead-Lag Signal</div>
    <div class="lead-lag-card">
        <div class="lead-lag-visual">
            <span class="lead-lag-symbol uvxy-badge">UVXY</span>
            <span class="lead-arrow">→</span>
            <span class="lead-lag-symbol spy-badge">SPY</span>
        </div>
        <div class="lead-lag-stats">1-day lead | 0.456 correlation</div>
    </div>

    <!-- Research Metrics Section -->
    <div class="section-title">Research Metrics</div>
    <div class="perf-card">
        <div class="perf-row">
            <span class="perf-label">GEX vs Technicals</span>
            <span class="perf-badge">5/6 WINS</span>
        </div>
        <div class="perf-row">
            <span class="perf-label">Sharpe Improvement</span>
            <span class="perf-value positive">+52%</span>
        </div>
        <div class="perf-row">
            <span class="perf-label">SPY Sharpe Gain</span>
            <span class="perf-value positive">+0.714</span>
        </div>
    </div>

    <!-- Legend Section -->
    <div class="section-title">Legend</div>
    <div class="legend">
        <div class="legend-item"><div class="legend-dot dot-red"></div>Short Gamma</div>
        <div class="legend-item"><div class="legend-dot dot-cyan"></div>Long Gamma</div>
        <div class="legend-item"><div class="legend-dot dot-yellow"></div>Spot Price</div>
        <div class="legend-item"><div class="legend-dot dot-purple"></div>Zero Gamma</div>
    </div>

    <!-- Terminology Section -->
    <div class="section-title">Terminology</div>
    <div class="glossary">
        <div class="glossary-item">
            <span class="glossary-term">GEX</span>
            <span class="glossary-def">Gamma Exposure - net gamma dealers hold from hedging options</span>
        </div>
        <div class="glossary-item">
            <span class="glossary-term">S²</span>
            <span class="glossary-def">Spot price squared - scaling factor in absolute GEX</span>
        </div>
        <div class="glossary-item">
            <span class="glossary-term">γ</span>
            <span class="glossary-def">Rate of change of delta; hedge adjustment per $1 move</span>
        </div>
        <div class="glossary-item">
            <span class="glossary-term">0γ</span>
            <span class="glossary-def">Zero gamma level - price where exposure flips long/short</span>
        </div>
        <div class="glossary-item">
            <span class="glossary-term">OI</span>
            <span class="glossary-def">Open Interest - total outstanding option contracts</span>
        </div>
        <div class="glossary-item">
            <span class="glossary-term">Tilt</span>
            <span class="glossary-def">Dealer positioning bias; negative = short gamma (amplifies)</span>
        </div>
    </div>

    <!-- Research Insight Box -->
    <div class="insight-box">
        <div class="insight-title">💡 RESEARCH INSIGHT</div>
        <div class="insight-text">@InsightText</div>
    </div>
</div>

@code {
    private bool IsDemo => StateService.State.Mode == DataMode.Demo;
    private bool IsSimulating => StateService.State.IsSimulating;
    private int PlaybackSpeed => StateService.State.PlaybackSpeed;
    private int CurrentIndex => StateService.State.CurrentIndex;
    private int MaxIndex => Math.Max(0, StateService.Timeline.Count - 1);
    private decimal Price => StateService.State.Price;
    private decimal OpenInterest => StateService.State.OpenInterest;
    private decimal Tilt => StateService.State.Tilt;
    private decimal StrikeStart => StateService.State.StrikeStart;
    private decimal StrikeEnd => StateService.State.StrikeEnd;
    private decimal ZeroGamma => StateService.State.CurrentDataPoint?.ZeroGamma ?? Price * 1.01m;
    private string SymbolLabel => StateService.State.CurrentSymbol ?? "SPY";

    private double ProgressPercent => MaxIndex > 0 ? (double)CurrentIndex / MaxIndex * 100 : 0;

    private string EventDate => StateService.State.CurrentDataPoint?.Date.ToString(AppConstants.DataFormat.DateFormat) ?? "Select a point";
    private string EventLabel => StateService.State.CurrentDataPoint?.Label ?? "Use controls or drag timeline";

    private string SparklineTitle
    {
        get
        {
            if (StateService.Timeline.Count < 2) return "Price History";
            var first = StateService.Timeline[0];
            var last = StateService.Timeline[^1];
            var startYear = first.Date.ToString(AppConstants.DataFormat.DateFormat).Split('-')[0];
            var endYear = last.Date.ToString(AppConstants.DataFormat.DateFormat).Split('-')[0];
            return $"{SymbolLabel} {startYear}-{endYear}";
        }
    }

    private int PersistenceBars => StateService.State.CurrentDataPoint?.RegimeDays ?? 1;
    private string PersistenceLabel => $"Day {PersistenceBars}";

    private string InsightText
    {
        get
        {
            var point = StateService.State.CurrentDataPoint;
            if (point == null)
                return "Run simulation to see how absolute GEX diverges from normalized ratios during market inflation.";

            if (point.IsNegativeGamma)
                return "Negative gamma regime detected. Dealers must sell into declines and buy into rallies, amplifying price moves.";

            return "Positive gamma regime. Dealers hedge by buying dips and selling rips, dampening volatility.";
        }
    }

    private string SelectedAssetClass = "";
    private string SelectedSymbol = "";
    private IEnumerable<string> AssetClasses = [];
    private IEnumerable<string> Symbols = [];
    private SymbolInfo? SymbolInfo;

    protected override async Task OnInitializedAsync()
    {
        StateService.OnStateChanged += StateHasChanged;
        await DataService.LoadIndexAsync();
        AssetClasses = DataService.GetAssetClasses();
    }

    private void SetMode(DataMode mode)
    {
        StateService.SetDataMode(mode);
        if (mode == DataMode.Demo)
        {
            SelectedAssetClass = "";
            SelectedSymbol = "";
            SymbolInfo = null;
        }
    }

    private void OnAssetClassChange(ChangeEventArgs e)
    {
        SelectedAssetClass = e.Value?.ToString() ?? "";
        SelectedSymbol = "";
        SymbolInfo = null;
        Symbols = DataService.GetSymbolsForClass(SelectedAssetClass);
    }

    private async Task OnSymbolChange(ChangeEventArgs e)
    {
        SelectedSymbol = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(SelectedSymbol)) return;

        SymbolInfo = DataService.GetSymbolInfo(SelectedSymbol);
        var timeline = await DataService.LoadSymbolAsync(SelectedSymbol);
        if (timeline != null)
        {
            StateService.SetTimeline(timeline.Timeline);
            StateService.State.CurrentSymbol = SelectedSymbol;
        }
    }

    private void SetSpeed(int speed) => StateService.SetPlaybackSpeed(speed);

    private void OnScrub(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var index))
            StateService.SetCurrentIndex(index);
    }

    private void OnPriceChange(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var price))
            StateService.UpdatePrice(price);
    }

    private void OnOiChange(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var oi))
            StateService.UpdateOpenInterest(oi);
    }

    private void OnTiltChange(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var tilt))
            StateService.UpdateTilt(tilt);
    }

    private void JumpToNextYear()
    {
        var current = StateService.State.CurrentDataPoint;
        if (current == null) { StateService.JumpToStart(); return; }

        var currentYear = current.Date.Year;
        var nextIndex = StateService.Timeline
            .Select((p, i) => (Point: p, Index: i))
            .FirstOrDefault(x => x.Point.Date.Year > currentYear);

        if (nextIndex.Point != null)
            StateService.SetCurrentIndex(nextIndex.Index);
    }

    private void JumpToPrevYear()
    {
        var current = StateService.State.CurrentDataPoint;
        if (current == null) { StateService.JumpToStart(); return; }

        var currentYear = current.Date.Year;
        var prevIndex = StateService.Timeline
            .Select((p, i) => (Point: p, Index: i))
            .LastOrDefault(x => x.Point.Date.Year < currentYear);

        if (prevIndex.Point != null)
            StateService.SetCurrentIndex(prevIndex.Index);
    }

    public void Dispose()
    {
        StateService.OnStateChanged -= StateHasChanged;
    }
}
