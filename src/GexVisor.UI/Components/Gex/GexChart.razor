@namespace GexVisor.UI.Components.Gex

<div class="gex-chart @(IsAbsolute ? "absolute-mode" : "normalized-mode")">
    <div class="y-axis @(_isDragging ? "dragging" : "")"
         @onwheel="OnYAxisWheel" @onwheel:preventDefault
         @ondblclick="OnYAxisDoubleClick"
         @onmousedown="OnYAxisMouseDown"
         @onmousedown:preventDefault
         title="Drag or scroll to zoom Y-axis, double-click to reset">
        @foreach (var label in YAxisLabels)
        {
            <div class="y-label">@label</div>
        }
    </div>
    <div class="chart-main @(_isDragging ? "dragging" : "")"
         @onwheel="OnChartWheel" @onwheel:preventDefault
         @onmousedown="OnChartMouseDown"
         @onmousedown:preventDefault
         @onmousemove="OnChartMouseMove"
         @onmouseleave="OnChartMouseLeave"
         title="Drag or scroll to adjust price (Shift for faster)">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="chart-svg">
            <!-- Grid layer (behind bars) -->
            <g class="grid-lines">
                @foreach (var line in GridLines)
                {
                    <line x1="@line.X1" y1="@line.Y1" x2="@line.X2" y2="@line.Y2"
                          class="grid-line grid-line-@line.LineType" />
                }
            </g>

            <!-- Center line (0 axis) - slightly bolder than grid -->
            <line x1="50" y1="0" x2="50" y2="100" class="center-line" />

            <!-- Gamma bars -->
            @foreach (var bar in GammaBars)
            {
                <rect
                    x="@bar.X"
                    y="@bar.Y"
                    width="@bar.Width"
                    height="@bar.Height"
                    rx="0.3"
                    class="gamma-bar @bar.ColorClass"
                    opacity="@bar.Opacity" />
            }

            <!-- Zero gamma line -->
            <line x1="0" y1="@ZeroGammaY" x2="100" y2="@ZeroGammaY" class="zero-gamma-line" />

            <!-- Price line -->
            <line x1="0" y1="@PriceY" x2="100" y2="@PriceY" class="price-line" />
        </svg>
        <!-- Responsive marker overlays (HTML for clamp() support) -->
        <div class="marker-overlay zero-gamma-marker" style="top: @(ZeroGammaY)%;">0γ</div>
        <div class="marker-overlay price-marker-overlay" style="top: @(PriceY)%;">SPOT</div>
        <!-- Zoom controls -->
        <div class="zoom-controls">
            <button class="zoom-btn" @onclick="OnZoomIn" title="Zoom In">+</button>
            <button class="zoom-btn" @onclick="OnZoomOut" title="Zoom Out">−</button>
            <button class="zoom-btn reset-btn" @onclick="OnResetZoom" title="Reset Zoom (R)">⟲</button>
        </div>
        <!-- Crosshair overlay -->
        @if (_showCrosshair)
        {
            <div class="crosshair-h" style="top: @(_crosshairY)%;"></div>
            <div class="crosshair-v" style="left: @(_crosshairX)%;"></div>
            <div class="crosshair-tooltip" style="left: @(_crosshairX + 2)%; top: @(_crosshairY - 8)%;">
                <span class="tooltip-price">$@_crosshairPrice.ToString("F0")</span>
                <span class="tooltip-gamma">@_crosshairGamma</span>
            </div>
        }
        <div class="x-axis @(_isDragging ? "dragging" : "")"
             @onwheel="OnXAxisWheel" @onwheel:preventDefault
             @ondblclick="OnXAxisDoubleClick"
             @onmousedown="OnXAxisMouseDown"
             @onmousedown:preventDefault
             title="Drag or scroll to zoom X-axis, double-click to reset">
            @foreach (var label in XAxisLabels)
            {
                <span class="x-label">@label</span>
            }
        </div>
    </div>
</div>
