@namespace GexVisor.UI.Components.Gex
@using GexVisor.UI.Configuration

<div class="shortcuts-overlay @(IsVisible ? "visible" : "")" @onclick="Close" @onclick:stopPropagation="true">
    <div class="shortcuts-modal" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h2>Keyboard Shortcuts</h2>
            <button class="close-btn" @onclick="Close">×</button>
        </div>

        <div class="shortcuts-content">
            @foreach (var group in AppConstants.Keyboard.Sections)
            {
                <div class="shortcut-section">
                    <h3>@group.Title</h3>
                    @foreach (var item in group.Items)
                    {
                        <div class="shortcut-item">
                            <span class="key">@item.Key</span>
                            <span class="desc">@item.LongDesc</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="modal-footer">
            <span class="hint">Press <span class="key small">Esc</span> or click outside to close</span>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
