@using GexVisor.UI.Models
@using GexVisor.UI.Services
@inject GexStateService StateService
@inject IJSRuntime JS
@implements IDisposable

<header class="gex-header" role="banner">
    <div class="header-left">
        <a href="/" class="logo" title="Back to Home" aria-label="Go to home page">
            <div class="logo-icon" aria-hidden="true">Γ</div>
            <div>
                <h1>GEX REGIME COMPARATOR <span class="badge">RESEARCH</span></h1>
            </div>
        </a>
    </div>

    <div class="header-center" role="region" aria-label="Current market metrics">
        <div class="metric-card" aria-live="polite">
            <div class="metric-label">@SymbolLabel Price</div>
            <div class="metric-value price-value">$@Price.ToString("F2")</div>
        </div>
        <div class="metric-card" aria-live="polite">
            <div class="metric-label">S² Factor</div>
            <div class="metric-value s2-value">@S2Factor.ToString("F1")x</div>
        </div>
        <div class="metric-card" aria-live="polite">
            <div class="metric-label">Total GEX</div>
            <div class="metric-value gex-value">@FormatGex(TotalGex)</div>
        </div>
    </div>

    <div class="header-right">
        <div class="export-dropdown">
            <button class="export-btn" @onclick="ToggleExportMenu" title="Export Chart as PNG" aria-label="Export chart as PNG" aria-expanded="@_showExportMenu" aria-haspopup="menu">
                <i class="fas fa-camera" aria-hidden="true"></i>
            </button>
            @if (_showExportMenu)
            {
                <div class="export-menu" role="menu" aria-label="Export options">
                    <button @onclick="ExportPractitioner" role="menuitem">Practitioner View</button>
                    <button @onclick="ExportPaper2" role="menuitem">Paper 2 View</button>
                    <button @onclick="ExportBoth" role="menuitem">Export Both</button>
                </div>
            }
        </div>
        <button class="help-btn" @onclick="OnHelpClick" title="Keyboard Shortcuts (?)" aria-label="Show keyboard shortcuts">?</button>
        <div class="year-badge @(HasData ? "" : "inactive")" aria-label="Current year: @YearDisplay">@YearDisplay</div>
    </div>
</header>

@if (ShowVolWarning)
{
    <div class="vol-warning @(IsNegativeGamma ? "active" : "")" role="status" aria-live="polite" aria-label="Gamma regime status">
        <div class="vol-stat">
            <div class="vol-pulse" aria-hidden="true"></div>
            <span>@GammaStatus</span>
        </div>
        <div class="vol-stat">
            <span class="vol-stat-label">Vol Effect:</span>
            <span class="vol-stat-value">@VolEffect.ToString("F1")x</span>
        </div>
        <div class="vol-stat">
            <span class="vol-stat-label">Outlook:</span>
            <span class="vol-stat-value">@Outlook</span>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnHelpRequested { get; set; }

    private bool _showExportMenu;

    private decimal Price => StateService.State.Price;
    private decimal S2Factor => StateService.State.S2Factor;
    private decimal TotalGex => StateService.State.CurrentDataPoint?.Gex ?? 0;
    private bool HasData => StateService.State.CurrentDataPoint != null;
    private bool IsNegativeGamma => StateService.State.CurrentDataPoint?.IsNegativeGamma ?? false;

    private string SymbolLabel => StateService.State.CurrentSymbol ?? "SPY";

    private string YearDisplay
    {
        get
        {
            var point = StateService.State.CurrentDataPoint;
            if (point == null) return "----";
            return point.Date.Split('-')[0];
        }
    }

    private bool ShowVolWarning => HasData;

    private string GammaStatus => IsNegativeGamma
        ? "GAMMA STATUS: SHORT γ (AMPLIFIED)"
        : "GAMMA STATUS: LONG γ (DAMPENED)";

    private decimal VolEffect => IsNegativeGamma ? 1.5m : 0.7m;

    private string Outlook => IsNegativeGamma ? "High Volatility" : "Mean Reversion";

    private static string FormatGex(decimal gex)
    {
        return gex switch
        {
            >= 1000 => $"${gex / 1000:F1}T",
            >= 1 => $"${gex:F1}B",
            _ => $"${gex * 1000:F0}M"
        };
    }

    private async Task OnHelpClick() => await OnHelpRequested.InvokeAsync();

    private void ToggleExportMenu() => _showExportMenu = !_showExportMenu;

    private string GetFilename(string suffix)
    {
        var symbol = SymbolLabel;
        var date = StateService.State.CurrentDataPoint?.Date ?? "unknown";
        return $"gex-{symbol}-{date}-{suffix}.png";
    }

    private async Task ExportPractitioner()
    {
        _showExportMenu = false;
        await JS.InvokeVoidAsync("GexInterop.exportChartAsPng",
            ".chart-panel:first-child", GetFilename("practitioner"));
    }

    private async Task ExportPaper2()
    {
        _showExportMenu = false;
        await JS.InvokeVoidAsync("GexInterop.exportChartAsPng",
            ".chart-panel:last-child", GetFilename("paper2"));
    }

    private async Task ExportBoth()
    {
        _showExportMenu = false;
        await JS.InvokeVoidAsync("GexInterop.exportBothChartsAsPng",
            GetFilename("combined"));
    }

    protected override void OnInitialized()
    {
        StateService.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        StateService.OnStateChanged -= StateHasChanged;
    }
}
