@using GexVisor.UI.Configuration
@using GexVisor.UI.Models
@using GexVisor.UI.Services
@inject IGexStateService StateService
@inject IGexExportService ExportService
@inject IJSRuntime JS
@implements IDisposable

<header class="gex-header" role="banner">
    <div class="header-left">
        <a href="/" class="logo" title="Back to Home" aria-label="Go to home page">
            <div class="logo-icon" aria-hidden="true">Γ</div>
            <div>
                <h1>GEX REGIME COMPARATOR <span class="badge">RESEARCH</span></h1>
            </div>
        </a>
    </div>

    <div class="header-center" role="region" aria-label="Current market metrics">
        <div class="metric-card @(UseLiveData ? "live" : "")" aria-live="polite">
            <div class="metric-label">@SymbolLabel Price @(UseLiveData ? "●" : "")</div>
            <div class="metric-value price-value">$@DisplayPrice.ToString("F2")</div>
        </div>
        <div class="metric-card" aria-live="polite">
            <div class="metric-label">S² Factor</div>
            <div class="metric-value s2-value">@S2Factor.ToString("F1")x</div>
        </div>
        <div class="metric-card" aria-live="polite">
            <div class="metric-label">Total GEX</div>
            <div class="metric-value gex-value">@FormatGex(DisplayTotalGex)</div>
        </div>
    </div>

    <div class="header-right">
        <div class="export-dropdown">
            <button class="export-btn" @onclick="ToggleExportMenu" title="Export Data" aria-label="Export data" aria-expanded="@_showExportMenu" aria-haspopup="menu">
                <i class="fas fa-download" aria-hidden="true"></i>
            </button>
            @if (_showExportMenu)
            {
                <div class="export-menu" role="menu" aria-label="Export options">
                    <div class="export-section">Charts</div>
                    <button @onclick="ExportNormalized" role="menuitem">Normalized (PNG)</button>
                    <button @onclick="ExportAbsolute" role="menuitem">Absolute (PNG)</button>
                    <button @onclick="ExportBoth" role="menuitem">Both Charts (PNG)</button>
                    <div class="export-section">Timeline Data</div>
                    <button @onclick="ExportTimelineCsv" role="menuitem">Timeline (CSV)</button>
                    <button @onclick="ExportTimelineJson" role="menuitem">Timeline (JSON)</button>
                    @if (StateService.UseLiveData && StateService.LiveGexData != null)
                    {
                        <div class="export-section">Live Strikes</div>
                        <button @onclick="ExportStrikesCsv" role="menuitem">Strikes (CSV)</button>
                        <button @onclick="ExportStrikesJson" role="menuitem">Strikes (JSON)</button>
                    }
                </div>
            }
        </div>
        <button class="help-btn" @onclick="OnHelpClick" title="Keyboard Shortcuts (?)" aria-label="Show keyboard shortcuts">?</button>
        <div class="year-badge @(HasData ? "" : "inactive")" aria-label="Current year: @YearDisplay">@YearDisplay</div>
    </div>
</header>

@if (ShowVolWarning)
{
    <div class="vol-warning @(IsNegativeGamma ? "active" : "")" role="status" aria-live="polite" aria-label="Gamma regime status">
        <div class="vol-stat">
            <div class="vol-pulse" aria-hidden="true"></div>
            <span>@GammaStatus</span>
        </div>
        <div class="vol-stat">
            <span class="vol-stat-label">Vol Effect:</span>
            <span class="vol-stat-value">@VolEffect.ToString("F1")x</span>
        </div>
        <div class="vol-stat">
            <span class="vol-stat-label">Outlook:</span>
            <span class="vol-stat-value">@Outlook</span>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnHelpRequested { get; set; }

    private bool _showExportMenu;

    private decimal Price => StateService.State.Price;
    private decimal S2Factor => StateService.State.S2Factor;
    private decimal TotalGex => StateService.State.CurrentDataPoint?.Gex ?? 0;
    private bool HasData => StateService.State.CurrentDataPoint != null;
    private bool IsNegativeGamma => StateService.State.CurrentDataPoint?.IsNegativeGamma ?? false;
    private bool UseLiveData => StateService.UseLiveData;

    // Display values: use live data when available, fall back to simulation
    private decimal DisplayPrice => UseLiveData && StateService.LiveGexData != null
        ? StateService.LiveGexData.SpotPrice
        : Price;

    private decimal DisplayTotalGex => UseLiveData && StateService.LiveGexData != null
        ? StateService.LiveGexData.TotalGex
        : TotalGex;

    private string SymbolLabel => StateService.State.CurrentSymbol ?? "SPY";

    private string YearDisplay
    {
        get
        {
            var point = StateService.State.CurrentDataPoint;
            if (point == null) return "----";
            return point.Date.ToString(AppConstants.DataFormat.DateFormat).Split('-')[0];
        }
    }

    private bool ShowVolWarning => HasData;

    private string GammaStatus => IsNegativeGamma
        ? "GAMMA STATUS: SHORT γ (AMPLIFIED)"
        : "GAMMA STATUS: LONG γ (DAMPENED)";

    private decimal VolEffect => IsNegativeGamma ? 1.5m : 0.7m;

    private string Outlook => IsNegativeGamma ? "High Volatility" : "Mean Reversion";

    private static string FormatGex(decimal gex)
    {
        return gex switch
        {
            >= 1000 => $"${gex / 1000:F1}T",
            >= 1 => $"${gex:F1}B",
            _ => $"${gex * 1000:F0}M"
        };
    }

    private async Task OnHelpClick() => await OnHelpRequested.InvokeAsync();

    private void ToggleExportMenu() => _showExportMenu = !_showExportMenu;

    private string GetFilename(string suffix, string extension = "png")
    {
        var symbol = SymbolLabel;
        var date = StateService.State.CurrentDataPoint?.Date.ToString(AppConstants.DataFormat.DateFormat) ?? DateTime.Today.ToString("yyyy-MM-dd");
        return $"gex-{symbol}-{date}-{suffix}.{extension}";
    }

    private async Task ExportNormalized()
    {
        _showExportMenu = false;
        await JS.InvokeVoidAsync("GexInterop.exportChartAsPng",
            ".chart-panel:first-child", GetFilename("normalized"));
    }

    private async Task ExportAbsolute()
    {
        _showExportMenu = false;
        await JS.InvokeVoidAsync("GexInterop.exportChartAsPng",
            ".chart-panel:last-child", GetFilename("absolute"));
    }

    private async Task ExportBoth()
    {
        _showExportMenu = false;
        await JS.InvokeVoidAsync("GexInterop.exportBothChartsAsPng",
            GetFilename("combined"));
    }

    private async Task ExportTimelineCsv()
    {
        _showExportMenu = false;
        var csv = ExportService.ExportTimelineToCsv(StateService.Timeline, SymbolLabel);
        await JS.InvokeVoidAsync("GexInterop.downloadFile",
            GetFilename("timeline", "csv"), csv, "text/csv");
    }

    private async Task ExportTimelineJson()
    {
        _showExportMenu = false;
        var json = ExportService.ExportTimelineToJson(StateService.Timeline, SymbolLabel);
        await JS.InvokeVoidAsync("GexInterop.downloadFile",
            GetFilename("timeline", "json"), json, "application/json");
    }

    private async Task ExportStrikesCsv()
    {
        _showExportMenu = false;
        var liveData = StateService.LiveGexData;
        if (liveData == null) return;

        var csv = ExportService.ExportStrikeGammasToCsv(liveData.StrikeGammas, liveData.Symbol, liveData.SpotPrice);
        await JS.InvokeVoidAsync("GexInterop.downloadFile",
            GetFilename("strikes", "csv"), csv, "text/csv");
    }

    private async Task ExportStrikesJson()
    {
        _showExportMenu = false;
        var liveData = StateService.LiveGexData;
        if (liveData == null) return;

        var json = ExportService.ExportStrikeGammasToJson(liveData.StrikeGammas, liveData.Symbol, liveData.SpotPrice);
        await JS.InvokeVoidAsync("GexInterop.downloadFile",
            GetFilename("strikes", "json"), json, "application/json");
    }

    protected override void OnInitialized()
    {
        StateService.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        StateService.OnStateChanged -= StateHasChanged;
    }
}
