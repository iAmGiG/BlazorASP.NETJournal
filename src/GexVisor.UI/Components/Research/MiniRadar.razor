@using GexVisor.UI.Models
@using GexVisor.UI.Services
@using GexVisor.UI.Configuration
@inject IResearchPathService ResearchPathService

<div class="mini-radar" style="width: @(Size)px; height: @(Size)px;">
    <svg viewBox="-350 -350 700 700" class="mini-radar-svg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Research Complexity Radar Summary">
        <!-- Quadrant backgrounds -->
        @foreach (var q in ResearchPathData.Quadrants.Where(x => x.Key != ResearchQuadrant.None))
        {
            var angles = RadarHelpers.GetQuadrantAngles(q.Key);
            var startRad = (angles.Start - 90) * Math.PI / 180;
            var endRad = (angles.End - 90) * Math.PI / 180;
            var outerR = RingRadii[^1];
            var x1 = outerR * Math.Cos(startRad);
            var y1 = outerR * Math.Sin(startRad);
            var x2 = outerR * Math.Cos(endRad);
            var y2 = outerR * Math.Sin(endRad);
            <path d="M 0 0 L @F(x1) @F(y1) A @outerR @outerR 0 0 1 @F(x2) @F(y2) Z"
                  fill="@q.Value.Color"
                  class="quadrant-bg" />
        }

        <!-- Concentric rings -->
        @for (int i = 1; i < RingRadii.Length; i++)
        {
            <circle cx="0" cy="0" r="@RingRadii[i]" class="ring-circle" />
        }

        <!-- Quadrant dividing lines -->
        @foreach (var q in ResearchPathData.Quadrants.Where(x => x.Key != ResearchQuadrant.None))
        {
            var angles = RadarHelpers.GetQuadrantAngles(q.Key);
            var rad = (angles.Start - 90) * Math.PI / 180;
            var outerR = RingRadii[^1];
            <line x1="0" y1="0" x2="@F(outerR * Math.Cos(rad))" y2="@F(outerR * Math.Sin(rad))"
                  class="quadrant-line" />
        }

        <!-- Center -->
        <g class="center-pulse">
            <circle cx="0" cy="0" r="40" class="center-bg" />
            @SvgText("0", "-5", "center-label", AppConstants.ResearchRadar.FoundationStats.DetectionRate)
            @SvgText("0", "10", "center-sublabel", "VALIDATED")
        </g>

        <!-- Research nodes -->
        @foreach (var path in _paths)
        {
            var (x, y) = GetNodePosition(path);
            var statusColor = ResearchPathData.StatusColors.GetValueOrDefault(path.Status, "#888");
            var radius = path.Ring == 0 ? 18 : 14;
            <g class="research-node @(SelectedPathId == path.Id ? "selected" : "")"
               transform="translate(@F(x), @F(y))"
               @onclick="@(() => HandleNodeClick(path))"
               @onclick:stopPropagation="true">
                <circle cx="0" cy="0" r="@radius" fill="@statusColor" class="node-circle">
                    <title>@path.Title - @path.Status</title>
                </circle>
                @SvgText("0", "4", "node-label", path.Label)
            </g>
        }
    </svg>

    @if (ShowLegend)
    {
        <div class="mini-radar-legend">
            @foreach (var status in ResearchPathData.StatusColors.Take(3))
            {
                <span class="legend-item">
                    <span class="legend-dot" style="background: @status.Value"></span>
                    @status.Key
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Size { get; set; } = 300;
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public string? SelectedPathId { get; set; }
    [Parameter] public EventCallback<ResearchPath> OnNodeClick { get; set; }

    private ResearchPath[] _paths = [];

    private static int[] RingRadii => RadarHelpers.RingRadii;

    protected override async Task OnInitializedAsync()
    {
        _paths = await ResearchPathService.LoadPathsAsync();
    }

    private static (double X, double Y) GetNodePosition(ResearchPath path) =>
        RadarHelpers.GetNodePosition(path);

    private string F(double value) =>
        value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private MarkupString SvgText(string x, string y, string className, string content) =>
        new($"<text x=\"{x}\" y=\"{y}\" class=\"{className}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");

    private async Task HandleNodeClick(ResearchPath path)
    {
        if (OnNodeClick.HasDelegate)
        {
            await OnNodeClick.InvokeAsync(path);
        }
    }
}
