@using GexVisor.UI.Models
@using GexVisor.UI.Configuration
@implements IDisposable

<div class="interactive-radar" style="width: @(Size)px; height: @(Size)px;" 
     @onmousemove="HandleMouseMove"
     @onmousedown="HandleMouseDown"
     @onmouseup="HandleMouseUp"
     @onmouseout="HandleMouseUp"
     @onwheel="HandleWheel"
     @onwheel:preventDefault
     tabindex="0"
     @onkeydown="HandleKeyDown"
     @onkeydown:stopPropagation="true"
     aria-label="Interactive Research Radar. Use arrow keys to navigate, Enter to select. Scroll to zoom, drag to pan.">
    
    @if (!IsViewReset)
    {
        <div class="radar-controls">
            <button class="radar-btn" @onclick="ResetZoom" title="Reset View (R)" @onclick:stopPropagation="true">
                <i class="fas fa-compress-arrows-alt"></i> Reset
            </button>
        </div>
    }

    <svg viewBox="@ViewBox" class="radar-svg" preserveAspectRatio="xMidYMid meet">
        <!-- Connection lines (rendered before nodes) -->
        <ConnectionLines SelectedPath="@SelectedPath"
                         AllPaths="@DisplayPaths"
                         Size="@Size" />

        <!-- Quadrant backgrounds -->
        @foreach (var q in ResearchPathData.Quadrants.Where(x => x.Key != ResearchQuadrant.None))
        {
            var angles = RadarHelpers.GetQuadrantAngles(q.Key);
            var startRad = (angles.Start - 90) * Math.PI / 180;
            var endRad = (angles.End - 90) * Math.PI / 180;
            var outerR = RingRadii[^1];
            var x1 = outerR * Math.Cos(startRad);
            var y1 = outerR * Math.Sin(startRad);
            var x2 = outerR * Math.Cos(endRad);
            var y2 = outerR * Math.Sin(endRad);
            <path d="M 0 0 L @F(x1) @F(y1) A @outerR @outerR 0 0 1 @F(x2) @F(y2) Z"
                  fill="@q.Value.Color"
                  class="quadrant-bg" />
        }

        <!-- Concentric rings -->
        @for (int i = 1; i < RingRadii.Length; i++)
        {
            <circle cx="0" cy="0" r="@RingRadii[i]" class="ring-circle" />
        }

        <!-- Quadrant dividing lines -->
        @foreach (var q in ResearchPathData.Quadrants.Where(x => x.Key != ResearchQuadrant.None))
        {
            var angles = RadarHelpers.GetQuadrantAngles(q.Key);
            var rad = (angles.Start - 90) * Math.PI / 180;
            var outerR = RingRadii[^1];
            <line x1="0" y1="0" x2="@F(outerR * Math.Cos(rad))" y2="@F(outerR * Math.Sin(rad))"
                  class="quadrant-line" />
        }

        <!-- Ring labels -->
        @if (ShowLabels)
        {
            @for (int i = 1; i <= 5; i++)
            {
                @SvgText("5", (-RingRadii[i] + 11).ToString(), "ring-label-text", ResearchPathData.RingNames[i])
            }

            <!-- Quadrant labels -->
            @foreach (var q in ResearchPathData.Quadrants.Where(x => x.Key != ResearchQuadrant.None))
            {
                var angles = RadarHelpers.GetQuadrantAngles(q.Key);
                var midAngle = (angles.Start + angles.End) / 2.0;
                var rad = (midAngle - 90) * Math.PI / 180;
                var r = RingRadii[^1] + 22;
                var x = r * Math.Cos(rad);
                var y = r * Math.Sin(rad);
                var rotation = midAngle > 90 && midAngle < 270 ? midAngle + 180 : midAngle;
                @SvgText(F(x), F(y), "quadrant-label-text", q.Value.Label, q.Value.Color, $"rotate({F(rotation)} {F(x)} {F(y)})")
            }
        }

        <!-- Center pulse -->
        <g class="center-pulse">
            <circle cx="0" cy="0" r="45" class="center-bg" />
            @SvgText("0", "-8", "center-label", "VALIDATED")
            @SvgText("0", "7", "center-sublabel", $"{AppConstants.ResearchRadar.FoundationStats.DetectionRate} / {AppConstants.ResearchRadar.FoundationStats.Accuracy}")
        </g>

        <!-- Research nodes -->
        @foreach (var path in DisplayPaths)
        {
            var (x, y) = GetNodePosition(path);
            var statusColor = ResearchPathData.StatusColors.GetValueOrDefault(path.Status, AppConstants.ResearchRadar.DefaultStatusColor);
            var isFiltered = FilteredPaths == null || FilteredPaths.Contains(path);
            var isSelected = SelectedPathId == path.Id;
            var isFocused = FocusedPathId == path.Id;
            var isRelated = _hoveredPath != null && _hoveredPath.Related.Any(r =>
                path.Title.Contains(r, StringComparison.OrdinalIgnoreCase) ||
                path.Related.Contains(r));
            var radius = path.Ring == 0 
                ? AppConstants.ResearchRadar.NodeSizes.InteractiveCore 
                : AppConstants.ResearchRadar.NodeSizes.InteractiveStandard;

            <g transform="translate(@F(x), @F(y))"
               role="button"
               tabindex="-1"
               aria-label="@path.Title"
               aria-describedby="desc-@path.Id"
               @onclick="@(() => HandleNodeClick(path))"
               @onclick:stopPropagation="true"
               @onmouseenter="@(() => HandleNodeHover(path))"
               @onmouseleave="@(() => HandleNodeHover(null))"
               @ontouchstart="@((e) => HandleTouchStart(e, path))"
               @ontouchend="@((e) => HandleTouchEnd(e, path))"
               @ontouchmove="@HandleTouchMove">
                <g class="research-node node-ring-@path.Ring @(isSelected ? "selected" : "") @(isFocused ? "focused" : "") @(!isFiltered ? "dimmed" : "") @(isRelated ? "related-glow" : "")">
                    <!-- Invisible hit target for easier clicking/touching -->
                    <circle cx="0" cy="0" r="@(radius + AppConstants.ResearchRadar.NodeSizes.HitTargetPadding)" fill="transparent" class="hit-target" />
                    <circle cx="0" cy="0" r="@radius" fill="@statusColor" class="node-circle" />
                    @if (!string.IsNullOrEmpty(path.LabelLong))
                    {
                        @SvgText("0", "-2", "node-label", path.Label)
                        @SvgText("0", "6", "node-label-long", path.LabelLong)
                    }
                    else
                    {
                        @SvgText("0", "3", "node-label", path.Label)
                    }
                    <title>@path.Title - @path.Status</title>
                    <desc id="desc-@path.Id">@RadarHelpers.FormatEnumName(path.Status) research path at complexity Ring @path.Ring. @RadarHelpers.FormatEnumName(path.Taxonomy) approach. Press Enter to view details.</desc>
                </g>
            </g>
        }
    </svg>

    <!-- Desktop Tooltip -->
    <RadarTooltip Path="@_hoveredPath"
                  IsVisible="@(_hoveredPath != null && string.IsNullOrEmpty(SelectedPathId))"
                  X="@_tooltipX"
                  Y="@_tooltipY" />
</div>

@code {
    /// <summary>Size of the radar in pixels (width and height).</summary>
    [Parameter] public int Size { get; set; } = 600;

    /// <summary>Whether to show ring and quadrant labels.</summary>
    [Parameter] public bool ShowLabels { get; set; } = true;

    /// <summary>ID of the currently selected path (for external state control).</summary>
    [Parameter] public string? SelectedPathId { get; set; }

    /// <summary>ID of the currently focused path for keyboard navigation.</summary>
    [Parameter] public string? FocusedPathId { get; set; }

    /// <summary>Optional filtered list of paths to highlight. Null means show all.</summary>
    [Parameter] public IEnumerable<ResearchPath>? FilteredPaths { get; set; }

    /// <summary>Optional custom list of paths to display. Defaults to all paths.</summary>
    [Parameter] public IEnumerable<ResearchPath>? Paths { get; set; }

    /// <summary>Callback when a node is clicked.</summary>
    [Parameter] public EventCallback<ResearchPath> OnNodeClick { get; set; }

    /// <summary>Callback when mouse enters/leaves a node (null on leave).</summary>
    [Parameter] public EventCallback<ResearchPath?> OnNodeHover { get; set; }

    /// <summary>Callback when keyboard focus changes to a different node.</summary>
    [Parameter] public EventCallback<ResearchPath?> OnFocusChange { get; set; }

    private ResearchPath? _hoveredPath;
    private double _tooltipX;
    private double _tooltipY;
    private CancellationTokenSource? _longPressCts;
    private ResearchPath? _touchedPath;

    private double _zoom = 1.0;
    private double _panX = 0;
    private double _panY = 0;
    private bool _isDragging;
    private double _lastMouseX;
    private double _lastMouseY;

    private bool IsViewReset => Math.Abs(_zoom - 1.0) < 0.001 && Math.Abs(_panX) < 0.1 && Math.Abs(_panY) < 0.1;

    private IEnumerable<ResearchPath> DisplayPaths => Paths ?? [];

    private ResearchPath? SelectedPath => string.IsNullOrEmpty(SelectedPathId)
        ? null
        : DisplayPaths.FirstOrDefault(p => p.Id == SelectedPathId);

    private static int[] RingRadii => RadarHelpers.RingRadii;

    private string ViewBox 
    {
        get 
        {
            var w = AppConstants.ResearchRadar.BaseSize / _zoom;
            var h = AppConstants.ResearchRadar.BaseSize / _zoom;
            var x = _panX - (w / 2);
            var y = _panY - (h / 2);
            return $"{F(x)} {F(y)} {F(w)} {F(h)}";
        }
    }

    private (double X, double Y) GetNodePosition(ResearchPath path) =>
        RadarHelpers.GetNodePosition(path);

    private string F(double value) =>
        RadarHelpers.FormatSvg(value);

    private MarkupString SvgText(string x, string y, string className, string content, string? fill = null, string? transform = null) =>
        RadarHelpers.CreateSvgText(x, y, className, content, fill, transform);

    private async Task HandleNodeClick(ResearchPath path)
    {
        if (OnNodeClick.HasDelegate)
        {
            await OnNodeClick.InvokeAsync(path);
        }
    }

    private async Task HandleNodeHover(ResearchPath? path)
    {
        _hoveredPath = path;
        if (OnNodeHover.HasDelegate)
        {
            await OnNodeHover.InvokeAsync(path);
        }
    }

    private void HandleMouseMove(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // Position tooltip with offset to avoid cursor overlap
        _tooltipX = e.ClientX + AppConstants.ResearchRadar.Tooltip.OffsetX;
        _tooltipY = e.ClientY + AppConstants.ResearchRadar.Tooltip.OffsetY;

        // Simple boundary detection to prevent tooltip from going off-screen
        // Assume typical viewport widths - tooltip is max 250px wide
        if (_tooltipX + AppConstants.ResearchRadar.Tooltip.WidthEstimate > AppConstants.ResearchRadar.Tooltip.ViewportWidthFallback)
        {
            _tooltipX = e.ClientX - (AppConstants.ResearchRadar.Tooltip.WidthEstimate + 10);
        }

        if (_tooltipY + AppConstants.ResearchRadar.Tooltip.HeightEstimate > AppConstants.ResearchRadar.Tooltip.ViewportHeightFallback)
        {
            _tooltipY = e.ClientY - AppConstants.ResearchRadar.Tooltip.HeightEstimate;
        }

        if (_isDragging)
        {
            var deltaX = e.ClientX - _lastMouseX;
            var deltaY = e.ClientY - _lastMouseY;
            
            // Convert pixel delta to SVG units
            var scale = (AppConstants.ResearchRadar.BaseSize / _zoom) / Size;
            
            _panX -= deltaX * scale;
            _panY -= deltaY * scale;
            
            _lastMouseX = e.ClientX;
            _lastMouseY = e.ClientY;
        }
    }

    private void HandleWheel(Microsoft.AspNetCore.Components.Web.WheelEventArgs e)
    {
        var zoomFactor = AppConstants.ResearchRadar.Zoom.Factor;
        if (e.DeltaY > 0)
        {
            _zoom /= zoomFactor;
        }
        else
        {
            _zoom *= zoomFactor;
        }
        _zoom = Math.Clamp(_zoom, AppConstants.ResearchRadar.Zoom.Min, AppConstants.ResearchRadar.Zoom.Max);
    }

    private void HandleMouseDown(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        _isDragging = true;
        _lastMouseX = e.ClientX;
        _lastMouseY = e.ClientY;
    }

    private void HandleMouseUp(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        _isDragging = false;
    }

    private void HandleTouchStart(Microsoft.AspNetCore.Components.Web.TouchEventArgs e, ResearchPath path)
    {
        _touchedPath = path;
        _longPressCts?.Cancel();
        _longPressCts = new CancellationTokenSource();

        _ = LongPressTask(_longPressCts.Token, path);
    }

    private async Task LongPressTask(CancellationToken token, ResearchPath path)
    {
        try
        {
            // Wait for long press duration
            await Task.Delay(500, token);
            if (token.IsCancellationRequested) return;

            // Long-press detected: show tooltip for 2 seconds
            _hoveredPath = path;
            StateHasChanged();

            // Wait then hide
            await Task.Delay(2000, token);
            if (token.IsCancellationRequested) return;

            _hoveredPath = null;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Ignore cancellation
        }
    }

    private async Task HandleTouchEnd(Microsoft.AspNetCore.Components.Web.TouchEventArgs e, ResearchPath path)
    {
        // If we haven't triggered the long press yet (token not cancelled by timeout logic), it's a tap
        if (_longPressCts != null && !_longPressCts.IsCancellationRequested && _hoveredPath != path)
        {
            _longPressCts.Cancel();
            await HandleNodeClick(path);
        }
        _touchedPath = null;
    }

    private void HandleTouchMove(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        _longPressCts?.Cancel();
    }

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        var pathsList = (FilteredPaths ?? DisplayPaths).ToList();
        if (pathsList.Count == 0) return;

        // Find current index based on focused or selected path
        var currentId = FocusedPathId ?? SelectedPathId;
        var currentIndex = currentId != null 
            ? pathsList.FindIndex(p => p.Id == currentId) 
            : -1;

        if (currentIndex == -1) currentIndex = 0;

        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
                var nextIndex = (currentIndex + 1) % pathsList.Count;
                if (OnFocusChange.HasDelegate) await OnFocusChange.InvokeAsync(pathsList[nextIndex]);
                break;
            case "ArrowLeft":
            case "ArrowUp":
                var prevIndex = (currentIndex - 1 + pathsList.Count) % pathsList.Count;
                if (OnFocusChange.HasDelegate) await OnFocusChange.InvokeAsync(pathsList[prevIndex]);
                break;
            case "Enter":
            case " ":
                await HandleNodeClick(pathsList[currentIndex]);
                break;
            case "Escape":
                if (OnFocusChange.HasDelegate) await OnFocusChange.InvokeAsync(null);
                break;
            case "r":
            case "R":
                ResetZoom();
                break;
        }
    }

    private void ResetZoom()
    {
        _zoom = 1.0;
        _panX = 0;
        _panY = 0;
    }

    public void Dispose()
    {
        _longPressCts?.Cancel();
        _longPressCts?.Dispose();
    }
}
