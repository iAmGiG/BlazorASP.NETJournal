@using GexVisor.Core
@using GexVisor.UI.Models
@using GexVisor.UI.Services
@using GexVisor.UI.Components.Charts
@inject IJSRuntime JS
@inject IPersonalAnalyticsService AnalyticsService

@* Modal for viewing detailed trade information *@

@if (IsVisible && Trade != null)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Trade Details</h2>
                <button class="close-btn" @onclick="Close">×</button>
            </div>

            <div class="modal-body">
                @* Trade Overview *@
                <section class="detail-section">
                    <h3>Trade Overview</h3>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="detail-label">Symbol</span>
                            <span class="detail-value symbol">@Trade.Ticker</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Type</span>
                            <span class="trade-type-badge @GetTypeBadgeClass(Trade.OptionTradeType)">
                                @Trade.OptionTradeType
                            </span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Date</span>
                            <span class="detail-value">@Trade.CreatedDate?.ToString("MM/dd/yyyy HH:mm")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Entry Price</span>
                            <span class="detail-value">$@Trade.EntryPrice.ToString("F2")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Exit Price</span>
                            <span class="detail-value">
                                @(Trade.ExitPrice.HasValue ? $"${Trade.ExitPrice.Value:F2}" : "Open")
                            </span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Quantity</span>
                            <span class="detail-value">@Trade.Quantity contracts</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">P&L</span>
                            @{
                                var pnl = Trade.CalculatePnL();
                                if (pnl.HasValue)
                                {
                                    <span class="detail-value pnl @(pnl.Value >= 0 ? "positive" : "negative")">
                                        @(pnl.Value >= 0 ? "+" : "")$@pnl.Value.ToString("F2")
                                    </span>
                                }
                                else
                                {
                                    <span class="detail-value">Open</span>
                                }
                            }
                        </div>
                    </div>
                </section>

                @* Price Chart *@
                @if (!string.IsNullOrEmpty(Trade.Ticker))
                {
                    <section class="detail-section chart-section">
                        <div class="chart-header">
                            <h3><i class="fas fa-chart-line"></i> Price Action</h3>
                            <div class="chart-controls">
                                <select @bind="selectedTimeframe" class="timeframe-select">
                                    <option value="1d">Daily</option>
                                    <option value="1h">Hourly</option>
                                    <option value="15m">15 Min</option>
                                </select>
                                <button class="btn-toggle" @onclick="ToggleChart">
                                    <i class="fas @(showChart ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                </button>
                            </div>
                        </div>
                        @if (showChart)
                        {
                            <TradeChart Trade="Trade" Timeframe="@selectedTimeframe" Height="280" />
                        }
                    </section>
                }

                @* Options Details *@
                <section class="detail-section">
                    <h3>Options Details</h3>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="detail-label">Strike Price</span>
                            <span class="detail-value">$@Trade.StrikePrice.ToString("F2")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Expiration</span>
                            <span class="detail-value">
                                @(Trade.ExpirationDate?.ToString("MM/dd/yyyy") ?? "N/A")
                            </span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Contract Multiplier</span>
                            <span class="detail-value">@Trade.ContractMultiplier</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Direction</span>
                            <span class="detail-value">
                                @(Trade.TradeDirection == GexVisor.Core.TradeLog.Type.Long ? "Long" : "Short")
                            </span>
                        </div>
                    </div>
                </section>

                @* System Decision Visualization *@
                @if (Decision != null)
                {
                    <section class="detail-section decision-visualization">
                        <h3>
                            <i class="fas fa-robot"></i> Autotrader Decision Analysis
                        </h3>

                        @* Active Patterns Display *@
                        @if (Decision.ActivePatterns.Any())
                        {
                            <div class="patterns-display">
                                <span class="section-label">Detected Patterns</span>
                                <div class="pattern-badges">
                                    @foreach (var pattern in Decision.ActivePatterns)
                                    {
                                        var strength = Decision.SignalStrengths.GetValueOrDefault(pattern, 0);
                                        <PatternBadge
                                            PatternName="@pattern"
                                            IsPrimary="@(pattern == Decision.PrimaryTrigger)"
                                            SignalStrength="@strength"
                                            ShowStrength="@(strength > 0)"
                                            Size="medium" />
                                    }
                                </div>
                            </div>
                        }

                        @* Regime Context Card *@
                        <RegimeContextCard Decision="@Decision" />

                        @* Decision Timeline *@
                        <DecisionTimeline Decision="@Decision" />
                    </section>
                }

                @* Notes & Analysis *@
                @if (!string.IsNullOrEmpty(Trade.Notes) || !string.IsNullOrEmpty(Trade.Analysis))
                {
                    <section class="detail-section">
                        <h3>Notes & Analysis</h3>
                        @if (!string.IsNullOrEmpty(Trade.Notes))
                        {
                            <div class="detail-item full-width">
                                <span class="detail-label">Notes</span>
                                <p class="notes-text">@Trade.Notes</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Trade.Analysis))
                        {
                            <div class="detail-item full-width">
                                <span class="detail-label">Analysis</span>
                                <p class="notes-text">@Trade.Analysis</p>
                            </div>
                        }
                    </section>
                }

                @* Self-Tracking Section *@
                <section class="detail-section tracking-section">
                    <div class="tracking-header" @onclick="ToggleTracking">
                        <h3>
                            <i class="fas fa-brain"></i> Self-Tracking
                        </h3>
                        <button class="btn-toggle">
                            <i class="fas @(_showTracking ? "fa-chevron-up" : "fa-chevron-down")"></i>
                        </button>
                    </div>
                    @if (_showTracking)
                    {
                        <div class="tracking-content">
                            <div class="tracking-grid">
                                <div class="tracking-field">
                                    <label>Emotional State</label>
                                    <select @bind="_trackingData.Emotion" @bind:after="SaveTrackingData">
                                        <option value="">Select...</option>
                                        @foreach (var state in Enum.GetValues<EmotionalState>())
                                        {
                                            <option value="@state">@GetEmotionDisplay(state)</option>
                                        }
                                    </select>
                                    <span class="field-hint">How did you feel when entering this trade?</span>
                                </div>
                                <div class="tracking-field">
                                    <label>Confidence Level</label>
                                    <div class="confidence-slider">
                                        <input type="range" min="1" max="10"
                                               value="@(_trackingData.ConfidenceLevel ?? 5)"
                                               @onchange="OnConfidenceChanged" />
                                        <div class="confidence-value">
                                            <span class="value">@(_trackingData.ConfidenceLevel ?? 5)</span>
                                            <span class="scale">/10</span>
                                        </div>
                                    </div>
                                    <span class="field-hint">1 = Low confidence, 10 = Very confident</span>
                                </div>
                            </div>
                            <div class="tracking-field full-width">
                                <label>Lesson Learned</label>
                                <textarea rows="3"
                                          placeholder="What did you learn from this trade? What would you do differently?"
                                          @bind="_trackingData.LessonLearned"
                                          @bind:after="SaveTrackingData"></textarea>
                            </div>
                            @if (_trackingSaved)
                            {
                                <div class="save-indicator">
                                    <i class="fas fa-check-circle"></i> Saved
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>

            <div class="modal-footer">
                <button class="btn-secondary" @onclick="Close">Close</button>
                <button class="btn-danger" @onclick="OnDelete">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public OptionsLog? Trade { get; set; }

    [Parameter]
    public TradeDecision? Decision { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDeleteTrade { get; set; }

    // Chart state
    private string selectedTimeframe = "1d";
    private bool showChart = true;

    // Self-tracking state
    private bool _showTracking = true;
    private bool _trackingSaved = false;
    private MutableTrackingData _trackingData = new();
    private System.Timers.Timer? _saveIndicatorTimer;

    // Mutable wrapper for binding
    private class MutableTrackingData
    {
        public EmotionalState? Emotion { get; set; }
        public int? ConfidenceLevel { get; set; }
        public string? LessonLearned { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && Trade != null)
        {
            await LoadTrackingData();
        }
    }

    private async Task LoadTrackingData()
    {
        var existing = AnalyticsService.GetTrackingData(Trade!.Id);
        if (existing != null)
        {
            _trackingData = new MutableTrackingData
            {
                Emotion = existing.Emotion,
                ConfidenceLevel = existing.ConfidenceLevel,
                LessonLearned = existing.LessonLearned
            };
        }
        else
        {
            _trackingData = new MutableTrackingData();
        }
        await Task.CompletedTask;
    }

    private void ToggleTracking()
    {
        _showTracking = !_showTracking;
    }

    private void ToggleChart()
    {
        showChart = !showChart;
    }

    private async Task OnConfidenceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            _trackingData.ConfidenceLevel = value;
            await SaveTrackingData();
        }
    }

    private async Task SaveTrackingData()
    {
        if (Trade == null) return;

        var data = new TradeTrackingData
        {
            TradeId = Trade.Id,
            Emotion = _trackingData.Emotion,
            ConfidenceLevel = _trackingData.ConfidenceLevel,
            LessonLearned = _trackingData.LessonLearned,
            UpdatedAt = DateTime.UtcNow
        };

        await AnalyticsService.SaveTrackingDataAsync(data);
        ShowSaveIndicator();
    }

    private void ShowSaveIndicator()
    {
        _trackingSaved = true;
        StateHasChanged();

        _saveIndicatorTimer?.Dispose();
        _saveIndicatorTimer = new System.Timers.Timer(2000);
        _saveIndicatorTimer.Elapsed += (_, _) =>
        {
            _trackingSaved = false;
            InvokeAsync(StateHasChanged);
            _saveIndicatorTimer?.Dispose();
        };
        _saveIndicatorTimer.Start();
    }

    private static string GetEmotionDisplay(EmotionalState state) => state switch
    {
        EmotionalState.Calm => "😌 Calm",
        EmotionalState.Confident => "💪 Confident",
        EmotionalState.Anxious => "😰 Anxious",
        EmotionalState.Excited => "🤩 Excited",
        EmotionalState.Fearful => "😨 Fearful",
        EmotionalState.Greedy => "🤑 Greedy",
        EmotionalState.Frustrated => "😤 Frustrated",
        EmotionalState.Neutral => "😐 Neutral",
        _ => state.ToString()
    };

    private void Close()
    {
        _saveIndicatorTimer?.Dispose();
        OnClose.InvokeAsync();
    }

    private async Task OnDelete()
    {
        if (Trade != null)
        {
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Are you sure you want to delete this trade? This action cannot be undone."
            );

            if (confirmed)
            {
                await OnDeleteTrade.InvokeAsync(Trade.Id);
            }
        }
    }

    private static string GetTypeBadgeClass(OptionsLog.TradeType type)
    {
        return type switch
        {
            OptionsLog.TradeType.BTO => "bto",
            OptionsLog.TradeType.STC => "stc",
            OptionsLog.TradeType.STO => "sto",
            OptionsLog.TradeType.BTC => "btc",
            _ => ""
        };
    }
}

<style>
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
    }

    .modal-content {
        background: var(--surface-0);
        border-radius: 8px;
        max-width: 800px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }

    .modal-header h2 {
        margin: 0;
        font-size: 1.5rem;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 2rem;
        cursor: pointer;
        color: var(--text-muted);
        line-height: 1;
        padding: 0;
        width: 2rem;
        height: 2rem;
    }

    .close-btn:hover {
        color: var(--text-color);
    }

    .modal-body {
        padding: 1.5rem;
    }

    .detail-section {
        margin-bottom: 2rem;
    }

    .detail-section:last-child {
        margin-bottom: 0;
    }

    .detail-section h3 {
        margin: 0 0 1rem 0;
        font-size: 1.1rem;
        color: var(--text-color);
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .detail-item.full-width {
        grid-column: 1 / -1;
    }

    .detail-label {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    .detail-value {
        font-size: 1rem;
        color: var(--text-color);
        font-weight: 500;
    }

    .detail-value.symbol {
        font-family: monospace;
        font-weight: 700;
    }

    .pnl.positive {
        color: var(--green);
    }

    .pnl.negative {
        color: var(--red);
    }

    .trade-type-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
        text-align: center;
        width: fit-content;
    }

    .trade-type-badge.bto {
        background: #10b98120;
        color: #10b981;
    }

    .trade-type-badge.stc {
        background: #10b98120;
        color: #10b981;
    }

    .trade-type-badge.sto {
        background: #ef444420;
        color: #ef4444;
    }

    .trade-type-badge.btc {
        background: #ef444420;
        color: #ef4444;
    }

    .decision-visualization {
        background: linear-gradient(135deg, var(--surface-0) 0%, var(--surface-1) 100%);
        padding: 1.5rem;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .decision-visualization h3 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1.5rem 0;
        font-size: 1.15rem;
        color: var(--text-color);
    }

    .decision-visualization h3 i {
        color: var(--accent);
    }

    .patterns-display {
        margin-bottom: 1.5rem;
    }

    .section-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .pattern-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .decision-visualization > *:not(:last-child) {
        margin-bottom: 1.25rem;
    }

    .rationale-text,
    .notes-text {
        margin: 0.5rem 0 0 0;
        line-height: 1.6;
        color: var(--text-color);
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        padding: 1.5rem;
        border-top: 1px solid var(--border-color);
    }

    .btn-secondary,
    .btn-danger {
        padding: 0.5rem 1.25rem;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.15s;
    }

    .btn-secondary {
        background: var(--surface-2);
        color: var(--text-color);
    }

    .btn-secondary:hover {
        background: var(--surface-3);
    }

    .btn-danger {
        background: #ef4444;
        color: white;
    }

    .btn-danger:hover {
        background: #dc2626;
    }

    /* Chart Section */
    .chart-section {
        background: var(--surface-1);
        border-radius: 8px;
        padding: 1rem;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .chart-header h3 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-size: 1rem;
    }

    .chart-header h3 i {
        color: var(--accent);
    }

    .chart-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .timeframe-select {
        padding: 0.35rem 0.75rem;
        background: var(--surface-2);
        border: 1px solid var(--border-color);
        border-radius: 4px;
        color: var(--text-color);
        font-size: 0.85rem;
        cursor: pointer;
    }

    .timeframe-select:focus {
        outline: none;
        border-color: var(--accent);
    }

    .btn-toggle {
        padding: 0.35rem 0.5rem;
        background: var(--surface-2);
        border: 1px solid var(--border-color);
        border-radius: 4px;
        color: var(--text-muted);
        cursor: pointer;
        transition: all 0.15s;
    }

    .btn-toggle:hover {
        color: var(--text-color);
        background: var(--surface-3);
    }

    @@media (max-width: 600px) {
        .chart-section {
            padding: 0.75rem;
        }

        .chart-header {
            flex-wrap: wrap;
            gap: 0.5rem;
        }
    }

    /* Self-Tracking Section */
    .tracking-section {
        background: var(--surface-1);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        border: 1px solid var(--border-color);
    }

    .tracking-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
    }

    .tracking-header h3 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }

    .tracking-header h3 i {
        color: var(--accent);
    }

    .tracking-content {
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color);
    }

    .tracking-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem;
        margin-bottom: 1.25rem;
    }

    .tracking-field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .tracking-field.full-width {
        grid-column: 1 / -1;
    }

    .tracking-field label {
        font-weight: 500;
        color: var(--text-color);
        font-size: 0.9rem;
    }

    .tracking-field select,
    .tracking-field textarea {
        padding: 0.625rem 0.75rem;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        background: var(--surface-2);
        color: var(--text-color);
        font-size: 0.95rem;
        width: 100%;
    }

    .tracking-field select:focus,
    .tracking-field textarea:focus {
        outline: none;
        border-color: var(--accent);
    }

    .tracking-field textarea {
        resize: vertical;
        min-height: 80px;
    }

    .field-hint {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .confidence-slider {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .confidence-slider input[type="range"] {
        flex: 1;
        height: 6px;
        border-radius: 3px;
        background: var(--surface-3);
        -webkit-appearance: none;
        appearance: none;
    }

    .confidence-slider input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--accent);
        cursor: pointer;
    }

    .confidence-slider input[type="range"]::-moz-range-thumb {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--accent);
        cursor: pointer;
        border: none;
    }

    .confidence-value {
        display: flex;
        align-items: baseline;
        min-width: 3rem;
    }

    .confidence-value .value {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--accent);
    }

    .confidence-value .scale {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .save-indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: #10b98120;
        color: #10b981;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        margin-top: 0.75rem;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
