@using GexVisor.UI.Models

@* Display chronological decision-making timeline *@

@if (Decision != null)
{
    <div class="decision-timeline">
        <div class="timeline-header">
            <i class="fas fa-stream"></i>
            <h4>Decision Timeline</h4>
            <span class="decision-time">@Decision.DecisionTime.ToString("HH:mm:ss")</span>
        </div>

        <div class="timeline-track">
            @* Pattern Detection Phase *@
            @if (Decision.ActivePatterns.Any())
            {
                <div class="timeline-event pattern-detection">
                    <div class="event-marker">
                        <div class="marker-dot"></div>
                        <div class="marker-line"></div>
                    </div>
                    <div class="event-content">
                        <div class="event-header">
                            <span class="event-icon"><i class="fas fa-radar"></i></span>
                            <h5>Pattern Detection</h5>
                            <span class="event-timestamp">T-2s</span>
                        </div>
                        <div class="event-body">
                            <p class="event-description">
                                Detected @Decision.ActivePatterns.Count active pattern@(Decision.ActivePatterns.Count != 1 ? "s" : "")
                            </p>
                            <div class="pattern-list">
                                @foreach (var pattern in Decision.ActivePatterns)
                                {
                                    var strength = Decision.SignalStrengths.GetValueOrDefault(pattern, 0);
                                    <div class="pattern-item">
                                        <span class="pattern-name">@pattern</span>
                                        @if (strength > 0)
                                        {
                                            <span class="pattern-strength">
                                                @strength.ToString("P0")
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* Regime Analysis Phase *@
            @if (!string.IsNullOrEmpty(Decision.RegimeType))
            {
                <div class="timeline-event regime-analysis">
                    <div class="event-marker">
                        <div class="marker-dot"></div>
                        <div class="marker-line"></div>
                    </div>
                    <div class="event-content">
                        <div class="event-header">
                            <span class="event-icon"><i class="fas fa-chart-area"></i></span>
                            <h5>Regime Analysis</h5>
                            <span class="event-timestamp">T-1s</span>
                        </div>
                        <div class="event-body">
                            <p class="event-description">
                                Market regime classified as <strong>@Decision.RegimeType</strong>
                            </p>
                            @if (Decision.GexLevel.HasValue || Decision.IvLevel.HasValue)
                            {
                                <div class="regime-indicators">
                                    @if (Decision.GexLevel.HasValue)
                                    {
                                        <span class="indicator">GEX: @Decision.GexLevel.Value.ToString("F2")B</span>
                                    }
                                    @if (Decision.IvLevel.HasValue)
                                    {
                                        <span class="indicator">IV: @Decision.IvLevel.Value.ToString("P1")</span>
                                    }
                                    @if (Decision.IsNegativeGamma.HasValue)
                                    {
                                        <span class="indicator gamma-@(Decision.IsNegativeGamma.Value ? "negative" : "positive")">
                                            @(Decision.IsNegativeGamma.Value ? "NEG" : "POS") γ
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @* Decision Phase *@
            <div class="timeline-event final-decision">
                <div class="event-marker">
                    <div class="marker-dot final"></div>
                </div>
                <div class="event-content">
                    <div class="event-header">
                        <span class="event-icon"><i class="fas fa-check-circle"></i></span>
                        <h5>Trade Decision</h5>
                        <span class="event-timestamp">T+0s</span>
                    </div>
                    <div class="event-body">
                        @if (!string.IsNullOrEmpty(Decision.PrimaryTrigger))
                        {
                            <p class="event-description">
                                Primary trigger: <strong>@Decision.PrimaryTrigger</strong>
                            </p>
                        }
                        @if (Decision.ConfidenceScore > 0)
                        {
                            <div class="confidence-indicator">
                                <span class="label">Confidence:</span>
                                <div class="confidence-bar-mini">
                                    <div class="fill" style="width: @((Decision.ConfidenceScore * 100).ToString("F0"))%"></div>
                                </div>
                                <span class="value">@Decision.ConfidenceScore.ToString("P0")</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Decision.DecisionRationale))
                        {
                            <div class="rationale">
                                <i class="fas fa-quote-left"></i>
                                <p>@Decision.DecisionRationale</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public TradeDecision? Decision { get; set; }
}

<style>
    .decision-timeline {
        background: var(--surface-0);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1.25rem;
    }

    .timeline-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border-color);
    }

    .timeline-header i {
        color: var(--accent);
        font-size: 1.1rem;
    }

    .timeline-header h4 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-color);
        flex: 1;
    }

    .decision-time {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-family: monospace;
    }

    .timeline-track {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .timeline-event {
        display: flex;
        gap: 1rem;
        position: relative;
    }

    .event-marker {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
    }

    .marker-dot {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--accent);
        border: 3px solid var(--surface-0);
        box-shadow: 0 0 0 2px var(--accent);
        z-index: 1;
    }

    .marker-dot.final {
        width: 20px;
        height: 20px;
        background: #10b981;
        box-shadow: 0 0 0 2px #10b981, 0 0 8px rgba(16, 185, 129, 0.3);
    }

    .marker-line {
        width: 2px;
        flex: 1;
        background: linear-gradient(180deg, var(--accent) 0%, var(--border-color) 100%);
        margin-top: 4px;
    }

    .event-content {
        flex: 1;
        padding-bottom: 0.5rem;
    }

    .event-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .event-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border-radius: 4px;
        background: var(--surface-2);
        color: var(--accent);
        font-size: 0.8rem;
    }

    .event-header h5 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-color);
        flex: 1;
    }

    .event-timestamp {
        font-size: 0.75rem;
        font-family: monospace;
        color: var(--text-muted);
        padding: 0.125rem 0.375rem;
        background: var(--surface-2);
        border-radius: 3px;
    }

    .event-body {
        padding-left: 2rem;
    }

    .event-description {
        margin: 0 0 0.75rem 0;
        font-size: 0.9rem;
        color: var(--text-color);
        line-height: 1.5;
    }

    .event-description strong {
        color: var(--accent);
        font-weight: 600;
    }

    .pattern-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .pattern-item {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.25rem 0.5rem;
        background: var(--surface-2);
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.8rem;
    }

    .pattern-name {
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .pattern-strength {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--accent);
    }

    .regime-indicators {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .regime-indicators .indicator {
        padding: 0.25rem 0.5rem;
        background: var(--surface-2);
        border-radius: 3px;
        font-size: 0.8rem;
        font-weight: 500;
        font-family: monospace;
    }

    .indicator.gamma-negative {
        color: #f59e0b;
    }

    .indicator.gamma-positive {
        color: #3b82f6;
    }

    .confidence-indicator {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0.5rem 0;
    }

    .confidence-indicator .label {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-muted);
    }

    .confidence-bar-mini {
        position: relative;
        flex: 1;
        height: 20px;
        background: var(--surface-2);
        border-radius: 3px;
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    .confidence-bar-mini .fill {
        height: 100%;
        background: linear-gradient(90deg, #3b82f6, #10b981);
        transition: width 0.3s ease;
    }

    .confidence-indicator .value {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-color);
        min-width: 3rem;
        text-align: right;
    }

    .rationale {
        margin-top: 0.75rem;
        padding: 0.75rem;
        background: var(--surface-1);
        border-left: 3px solid var(--accent);
        border-radius: 4px;
    }

    .rationale i {
        color: var(--accent);
        font-size: 0.75rem;
        margin-bottom: 0.375rem;
        opacity: 0.6;
    }

    .rationale p {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--text-color);
        font-style: italic;
    }
</style>
